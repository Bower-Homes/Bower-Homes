---
import faqs from '../data/faq.json';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  lang?: 'en' | 'es';
}

const SITE_URL = 'https://bowerhomesfl.com';
const EN_URL = `${SITE_URL}/`;
const ES_URL = `${SITE_URL}/es/`;

const {
  lang = 'es',
  title = lang === 'en'
    ? 'Bower Homes — Invest in Florida with 12–20% ROI'
    : 'Bower Homes — Invertí en Florida con ROI del 12–20%',
  description = lang === 'en'
    ? 'Bower Homes develops Single Family Homes in Southwest Florida for international investors. Collective Investment with 12–20% annual ROI or Turnkey builds. 8+ years of experience, our own capital in every project.'
    : 'Bower Homes desarrolla Single Family Homes en Florida para inversores argentinos. Inversión Colectiva con 12–20% ROI anual o Llave en Mano. Más de 8 años de experiencia, capital propio en cada proyecto.',
  canonicalUrl = lang === 'en' ? EN_URL : ES_URL,
} = Astro.props;

const ogLocale = lang === 'en' ? 'en_US' : 'es_AR';
const ogLocaleAlternate = lang === 'en' ? 'es_AR' : 'en_US';

const ogImage = 'https://bowerhomesfl.com/og-image.svg';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Bower Homes',
  url: 'https://bowerhomesfl.com',
  logo: 'https://bowerhomesfl.com/favicon.svg',
  description: 'Empresa de desarrollo inmobiliario residencial en Southwest Florida. Especializada en Single Family Homes con inversión compartida y proyectos Llave en Mano.',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Florida',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-201-210-9949',
    contactType: 'sales',
    email: 'freddy@bowerhomesfl.com',
    availableLanguage: ['Spanish', 'English'],
  },
  sameAs: [],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.respuesta,
    },
  })),
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang: reciprocal EN/ES-AR annotations, identical on both pages -->
    <link rel="alternate" hreflang="en" href={EN_URL} />
    <link rel="alternate" hreflang="es-AR" href={ES_URL} />
    <link rel="alternate" hreflang="x-default" href={EN_URL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:site_name" content="Bower Homes" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Theme color (browser chrome / mobile) -->
    <meta name="theme-color" content="#165C7D" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/logos/BOWER_LOGO-03.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/logos/BOWER_LOGO-03.png" />

    <!-- Fonts: Barlow Semi Condensed self-hosted — preload pesos críticos -->
    <link rel="preload" href="/fonts/BarlowSemiCondensed-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BarlowSemiCondensed-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- JSON-LD: FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <slot />

    <script>
      // Scroll reveal observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );

      document.querySelectorAll('.reveal, .reveal-fade').forEach((el) => {
        observer.observe(el);
      });
    </script>
    <script define:vars={{ lang }}>
      document.cookie = 'preferred-lang=' + lang + '; path=/; max-age=31536000; samesite=lax';
    </script>
  </body>
</html>
