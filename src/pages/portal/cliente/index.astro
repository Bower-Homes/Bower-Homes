---
export const prerender = false;
import { createSupabaseAdmin } from '../../../lib/supabase';
import { getPortalT } from '../../../i18n/portal';

const lang = 'es';
const t = getPortalT(lang);

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

const supabase = createSupabaseAdmin();

const { data: projectClients } = await supabase
  .from('project_clients')
  .select('project_id, investment_amount, investment_product, projects:project_id(*)')
  .eq('client_id', user.id);

const requestedProjectId = Astro.url.searchParams.get('project');
const projectClient = (requestedProjectId
  ? projectClients?.find((pc: any) => pc.project_id === requestedProjectId)
  : projectClients?.[0]) as any;
const project = projectClient?.projects as any;
const clientInvestmentAmount = projectClient?.investment_amount || null;
const clientInvestmentProduct = projectClient?.investment_product || null;
const hasMultipleProjects = (projectClients?.length || 0) > 1;

let stages: any[] = [];
let photos: any[] = [];
let documents: any[] = [];
let camera: any = null;
let investorTerms: any = null;
let myTransactions: any[] = [];

if (project) {
  const [stagesRes, photosRes, docsRes, camRes, termsRes, txRes] = await Promise.all([
    supabase.from('stages').select('*').eq('project_id', project.id).order('order_index'),
    supabase.from('photos').select('*, stages:stage_id(name)').eq('project_id', project.id).order('created_at', { ascending: false }),
    supabase.from('documents').select('id, name, file_url, file_type, cloudinary_public_id, stage_id, client_id, created_at').eq('project_id', project.id).order('created_at', { ascending: false }),
    supabase.from('cameras').select('*').eq('project_id', project.id).single(),
    supabase.from('investor_terms').select('*').eq('project_id', project.id).eq('client_id', user.id).single(),
    supabase.from('transactions').select('*').eq('project_id', project.id).eq('client_id', user.id).order('date', { ascending: false }),
  ]);
  stages = stagesRes.data || [];
  photos = photosRes.data || [];
  documents = (docsRes.data || []).filter((d: any) => !d.client_id || d.client_id === user.id);
  investorTerms = termsRes.data;
  myTransactions = txRes.data || [];
  camera = camRes.data;
}

function calcProgress(stgs: any[]) {
  if (!stgs?.length) return 0;
  return Math.round(stgs.reduce((s, st) => s + (st.progress || 0), 0) / stgs.length);
}

function formatAmount(n: number | null) {
  if (!n) return '—';
  return '$' + Number(n).toLocaleString('en-US');
}

function formatDelivery(d: string | null) {
  if (!d) return '—';
  const date = new Date(d + 'T00:00:00');
  const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  return months[date.getMonth()] + ' ' + date.getFullYear();
}

function stageClass(s: any) {
  if (s.status === 'completed' || s.progress >= 100) return 'complete';
  if (s.status === 'in_progress' || s.progress > 0) return 'progress';
  return 'pending';
}

function stageBadgeLabel(s: any) {
  const c = stageClass(s);
  if (c === 'complete') return t.clientPortal.legendComplete;
  if (c === 'progress') return t.clientPortal.legendProgress;
  return t.clientPortal.legendPending;
}

function dashOffset(progress: number) {
  const circumference = 125.66;
  return circumference - (circumference * progress / 100);
}

function photosByStage(stageId: string) {
  return photos.filter((p: any) => p.stage_id === stageId);
}

const overallProgress = calcProgress(stages);
const activeStages = stages.filter((s: any) => s.status === 'in_progress' || (s.progress > 0 && s.progress < 100)).length;
const firstName = user.fullName?.split(' ')[0] || user.email?.split('@')[0] || t.clientPortal.role;

const myAportes = myTransactions.filter((tx: any) => tx.type === 'aporte');
const myRetornos = myTransactions.filter((tx: any) => tx.type === 'retorno');
const totalAportado = myAportes.reduce((s: number, tx: any) => s + (Number(tx.amount) || 0), 0);
const totalRetornado = myRetornos.reduce((s: number, tx: any) => s + (Number(tx.amount) || 0), 0);
const roiMin = investorTerms?.roi_min || null;
const roiMax = investorTerms?.roi_max || null;
const roiReal = investorTerms?.roi_real != null ? investorTerms.roi_real : null;
const gananciaMin = clientInvestmentAmount && roiMin ? (clientInvestmentAmount * roiMin / 100) : null;
const gananciaMax = clientInvestmentAmount && roiMax ? (clientInvestmentAmount * roiMax / 100) : null;
const termsStatus = investorTerms?.status || 'activo';
const termsReturnDate = investorTerms?.return_date || null;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{t.clientPortal.pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/BarlowSemiCondensed-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/BarlowSemiCondensed-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy-900: #0c1524;
      --navy-800: #141d34;
      --navy-700: #1e2a45;
      --navy-600: #2c3a5c;
      --navy-400: #5e6d8c;
      --navy-300: #8894b0;
      --sky: #38bdf8;
      --sky-hover: #0ea5e9;
      --surface: #f0f1f5;
      --white: #ffffff;
    }

    html, body { overflow-x: hidden; max-width: 100vw; }

    body {
      font-family: 'Barlow Semi Condensed', system-ui, sans-serif;
      background: var(--surface);
      color: #333;
      min-height: 100vh;
    }

    .font-heading { font-family: 'Barlow Semi Condensed', system-ui, sans-serif; }

    /* Toast */
    .toast {
      position: fixed; bottom: 2rem; left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--navy-800); color: var(--white);
      padding: 0.7rem 1.5rem; border-radius: 0.75rem;
      font-size: 0.85rem; font-weight: 600;
      box-shadow: 0 8px 30px rgba(0,0,0,0.3);
      z-index: 999; opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease;
      pointer-events: none; border: 1px solid var(--navy-600);
    }
    .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

    /* Header */
    .portal-header {
      background: var(--navy-900);
      border-bottom: 1px solid var(--navy-600);
      position: sticky; top: 0; z-index: 50;
    }
    .portal-header-top {
      max-width: 1100px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      height: 64px; padding: 0 1.5rem;
    }
    .portal-logo {
      font-family: 'Barlow Semi Condensed', system-ui, sans-serif;
      font-size: 1.1rem; font-weight: 700; color: #fff;
      letter-spacing: 0.04em;
    }
    .portal-header .user-info { display: flex; align-items: center; gap: 0.75rem; }
    .portal-header .user-name { color: var(--white); font-weight: 600; font-size: 0.85rem; }
    .portal-header .user-role { color: var(--navy-300); font-size: 0.7rem; }
    .logout-btn {
      background: rgba(44,58,92,0.5); border: 1px solid var(--navy-600);
      color: var(--navy-300); font-size: 0.75rem; font-weight: 600;
      padding: 0.4rem 0.85rem; border-radius: 0.5rem;
      cursor: pointer; transition: all 0.2s;
    }
    .logout-btn:hover { color: var(--white); border-color: var(--sky); }

    /* Nav tabs */
    .portal-nav { background: var(--navy-800); border-top: 1px solid var(--navy-700); }
    .portal-nav-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; gap: 0; padding: 0 1.5rem;
      overflow-x: auto; -webkit-overflow-scrolling: touch;
    }
    .portal-nav a {
      display: flex; align-items: center; gap: 0.4rem;
      padding: 0.75rem 1.25rem; font-size: 0.8rem; font-weight: 600;
      color: var(--navy-300); text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: all 0.2s; white-space: nowrap; flex-shrink: 0;
    }
    .portal-nav a:hover { color: var(--white); }
    .portal-nav a.active { color: var(--sky); border-bottom-color: var(--sky); }
    .portal-nav a svg { width: 16px; height: 16px; }

    /* Body */
    .portal-body {
      max-width: 1100px; width: 100%;
      margin: 0 auto; padding: 2rem 1.5rem 2rem;
    }
    .welcome-text { font-size: 1.5rem; font-weight: 700; color: var(--navy-900); margin-bottom: 0.25rem; }
    .welcome-sub { color: var(--navy-400); font-size: 0.85rem; margin-bottom: 1.5rem; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @media (max-width: 640px) { .stats-grid { grid-template-columns: 1fr; } }
    .stat-card {
      background: var(--white); border: 1px solid #dce0ea;
      border-radius: 1rem; padding: 1.5rem; text-align: center;
    }
    .stat-label {
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: var(--navy-400); margin-bottom: 0.5rem;
    }
    .stat-value { font-family: 'Barlow Semi Condensed', system-ui, sans-serif; font-size: 2rem; font-weight: 700; color: var(--navy-900); }
    .stat-value.sky { color: var(--sky-hover); }
    .stat-sub { font-size: 0.75rem; color: var(--navy-300); margin-top: 0.25rem; }

    /* Section cards */
    .section-card {
      background: var(--white); border: 1px solid #dce0ea;
      border-radius: 1rem; overflow: hidden; margin-bottom: 1.5rem; max-width: 100%;
    }
    .section-card-header {
      padding: 1.25rem 1.5rem; font-weight: 700; font-size: 1rem;
      color: var(--navy-900); border-bottom: 1px solid #dce0ea;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .section-card-header .icon {
      width: 32px; height: 32px; background: rgba(56,189,248,0.1);
      border-radius: 0.5rem; display: flex; align-items: center; justify-content: center;
    }
    .section-card-header .icon svg { width: 16px; height: 16px; color: var(--sky-hover); }

    /* Stage legend */
    .stage-legend { display: flex; gap: 1.25rem; padding: 0.75rem 1.5rem; border-bottom: 1px solid #eef0f4; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; font-weight: 600; color: var(--navy-400); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
    .legend-dot.complete { background: #22c55e; }
    .legend-dot.progress { background: var(--sky); }
    .legend-dot.pending { background: #dce0ea; }

    /* Accordion stages */
    .stage { border-bottom: 1px solid #eef0f4; transition: background 0.2s, border-color 0.2s; }
    .stage:last-child { border-bottom: none; }
    .stage.is-progress { border-left: 4px solid var(--sky); background: #f0f9ff; }
    .stage-header {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 1rem 1.25rem; cursor: pointer;
      transition: background 0.15s; user-select: none; min-width: 0;
    }
    .stage-header:hover { background: #f8f9fb; }
    .stage.is-progress .stage-header:hover { background: #e0f2fe; }

    .progress-ring { width: 48px; height: 48px; flex-shrink: 0; position: relative; }
    .progress-ring svg { width: 48px; height: 48px; transform: rotate(-90deg); }
    .progress-ring .bg { stroke: #e8eaf0; fill: none; stroke-width: 4; }
    .progress-ring .fill { fill: none; stroke-width: 4; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
    .fill-complete { stroke: #22c55e; }
    .fill-progress { stroke: var(--sky); }
    .fill-pending { stroke: #dce0ea; }
    .progress-ring .pct {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.65rem; font-weight: 700; color: var(--navy-900);
    }

    .stage-info { flex: 1; min-width: 0; overflow: hidden; }
    .stage-title { font-weight: 600; font-size: 0.9rem; color: var(--navy-900); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .stage-sub { font-size: 0.75rem; color: var(--navy-300); margin-top: 0.15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .stage-badge {
      font-size: 0.65rem; font-weight: 700; padding: 0.25rem 0.6rem;
      border-radius: 999px; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;
    }
    .badge-active { background: #dbeafe; color: #1d4ed8; }
    .badge-complete { background: #dcfce7; color: #15803d; }
    .badge-progress { background: #e0f2fe; color: #0369a1; }
    .badge-pending { background: #f3f4f6; color: #6b7280; }

    .stage-chevron {
      width: 20px; height: 20px; color: var(--navy-300);
      transition: transform 0.3s ease; flex-shrink: 0;
    }
    .stage.open .stage-chevron { transform: rotate(180deg); }

    .stage-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .stage-body-inner { padding: 0 1.5rem 1.25rem; }
    .stage.open .stage-body { max-height: 800px; }

    .stage-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem; }
    .stage-photos img {
      width: 100%; aspect-ratio: 4/3; object-fit: cover;
      border-radius: 0.75rem; border: 1px solid #e8eaf0;
      cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;
    }
    .stage-photos img:hover { transform: scale(1.03); box-shadow: 0 4px 16px rgba(0,0,0,0.15); }

    .stage-desc { font-size: 0.85rem; color: var(--navy-400); line-height: 1.6; }

    /* Lightbox */
    .lightbox-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: rgba(0,0,0,0.92);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s;
    }
    .lightbox-overlay.active { opacity: 1; visibility: visible; }
    .lightbox-img {
      max-width: 90vw; max-height: 85vh; object-fit: contain;
      border-radius: 0.75rem; box-shadow: 0 8px 40px rgba(0,0,0,0.5);
    }
    .lightbox-close {
      position: absolute; top: 1rem; right: 1.5rem;
      background: none; border: none; color: #fff; font-size: 2rem;
      cursor: pointer; width: 44px; height: 44px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%; transition: background 0.2s;
    }
    .lightbox-close:hover { background: rgba(255,255,255,0.15); }
    .lightbox-nav {
      position: absolute; top: 50%; transform: translateY(-50%);
      background: rgba(255,255,255,0.1); border: none; color: #fff;
      font-size: 1.5rem; cursor: pointer; width: 48px; height: 48px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%; transition: background 0.2s;
    }
    .lightbox-nav:hover { background: rgba(255,255,255,0.25); }
    .lightbox-prev { left: 1rem; }
    .lightbox-next { right: 1rem; }
    .lightbox-counter {
      position: absolute; bottom: 1.5rem; left: 50%;
      transform: translateX(-50%); color: rgba(255,255,255,0.7); font-size: 0.85rem;
    }

    /* Documents */
    .doc-row {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 1rem 1.5rem; border-bottom: 1px solid #eef0f4;
      transition: background 0.15s; text-decoration: none; color: inherit;
    }
    .doc-row:last-child { border-bottom: none; }
    .doc-row:hover { background: #f8f9fb; }
    .doc-icon {
      width: 36px; height: 36px; border-radius: 0.5rem;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .doc-icon.available { background: rgba(34,197,94,0.1); }
    .doc-icon svg { width: 18px; height: 18px; }
    .doc-info { flex: 1; min-width: 0; }
    .doc-name { font-size: 0.85rem; font-weight: 600; color: var(--navy-900); }
    .doc-meta { font-size: 0.7rem; color: var(--navy-300); margin-top: 0.15rem; }
    .doc-badge { font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px; flex-shrink: 0; }
    .doc-badge.ready { background: #dcfce7; color: #15803d; }
    .doc-download { width: 18px; height: 18px; color: var(--navy-300); flex-shrink: 0; transition: color 0.2s; }
    .doc-row:hover .doc-download { color: var(--sky); }

    /* Camera */
    .cam-card { padding: 1.5rem; }
    .cam-info { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    @media (max-width: 480px) { .cam-info { grid-template-columns: 1fr; } }
    .cam-field label {
      display: block; font-size: 0.7rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--navy-400); margin-bottom: 0.35rem;
    }
    .cam-field .value {
      background: var(--surface); border: 1px solid #dce0ea;
      border-radius: 0.5rem; padding: 0.6rem 0.75rem;
      font-family: monospace; font-size: 0.85rem; color: var(--navy-900);
      font-weight: 600; display: flex; align-items: center; gap: 0.5rem;
      max-width: 100%; word-break: break-all;
    }
    .cam-field .value span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .toggle-btn, .copy-btn {
      background: none; border: none; color: var(--navy-300);
      cursor: pointer; padding: 0.2rem; border-radius: 0.25rem;
      transition: color 0.2s; flex-shrink: 0;
    }
    .toggle-btn:hover, .copy-btn:hover { color: var(--sky); }
    .toggle-btn svg, .copy-btn svg { width: 16px; height: 16px; }

    .dmss-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1.5rem; }
    @media (max-width: 640px) { .dmss-steps { grid-template-columns: 1fr 1fr; } }
    .dmss-step {
      text-align: center; padding: 1rem 0.5rem;
      background: var(--surface); border-radius: 0.75rem; border: 1px solid #dce0ea;
    }
    .dmss-step-num {
      width: 28px; height: 28px; background: var(--sky); color: var(--navy-900);
      border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 700; margin-bottom: 0.5rem;
    }
    .dmss-step-text { font-size: 0.75rem; color: var(--navy-400); line-height: 1.4; font-weight: 500; }

    .cam-apps { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
    .app-badge-link { display: block; height: 44px; transition: opacity 0.2s; }
    .app-badge-link:hover { opacity: 0.85; }
    .app-badge-link img { height: 44px; border-radius: 8px; }
    .app-badge-link.gplay { height: 64px; margin: -10px 0; }
    .app-badge-link.gplay img { height: 64px; }
    .cam-note { margin-top: 1rem; font-size: 0.75rem; color: var(--navy-300); line-height: 1.5; }
    .cam-note a { color: var(--sky); text-decoration: none; }

    /* Back link */
    .back-link {
      display: inline-flex; align-items: center; gap: 0.4rem;
      color: var(--navy-300); font-size: 0.8rem; text-decoration: none;
      margin-bottom: 1.5rem; transition: color 0.2s;
    }
    .back-link:hover { color: var(--sky); }
    .back-link svg { width: 16px; height: 16px; }

    /* No project state */
    .no-project {
      min-height: 60vh; display: flex; align-items: center; justify-content: center;
      text-align: center; padding: 2rem;
    }
    .no-project h2 { font-size: 1.3rem; color: var(--navy-900); margin-bottom: 0.5rem; }
    .no-project p { color: var(--navy-400); font-size: 0.9rem; margin-bottom: 1.5rem; max-width: 400px; }
    .no-project .wa-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: #25D366; color: #fff; font-weight: 700;
      font-size: 0.85rem; padding: 0.75rem 1.5rem;
      border-radius: 0.75rem; text-decoration: none; transition: background 0.2s;
    }
    .no-project .wa-btn:hover { background: #1da851; }

    /* Footer */
    .portal-footer {
      max-width: 1100px; margin: 0 auto; padding: 1.5rem;
      text-align: center; font-size: 0.7rem; color: var(--navy-400);
      border-top: 1px solid #dce0ea;
    }
    .portal-footer a { color: var(--navy-300); text-decoration: none; transition: color 0.2s; }
    .portal-footer a:hover { color: var(--sky); }

    /* Empty docs */
    .empty-section {
      padding: 2rem 1.5rem; text-align: center; color: var(--navy-300); font-size: 0.85rem;
    }
  </style>
</head>
<body>

<div id="toast" class="toast"></div>

<header class="portal-header">
  <div class="portal-header-top">
    <span class="portal-logo">BOWER HOMES</span>
    <div class="user-info">
      <div style="text-align:right">
        <div class="user-name">{user.fullName || user.email}</div>
        <div class="user-role">{t.clientPortal.role}</div>
      </div>
      <button id="logout-btn" class="logout-btn">{t.clientPortal.logout}</button>
    </div>
  </div>
  {project && (
    <nav class="portal-nav">
      <div class="portal-nav-inner">
        <a href="#section-dashboard" class="active" data-nav="dashboard">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" /></svg>
          {t.clientPortal.navDashboard}
        </a>
        <a href="#section-investment" data-nav="investment">
