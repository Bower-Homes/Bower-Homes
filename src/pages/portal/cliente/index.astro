                    <th style="text-align:left;padding:0.6rem 0.75rem;font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#5e6d8c;">{t.clientPortal.amountHeader}</th>
                    <th style="text-align:left;padding:0.6rem 0.75rem;font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#5e6d8c;">{t.clientPortal.dateHeader}</th>
                    <th style="text-align:left;padding:0.6rem 0.75rem;font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#5e6d8c;">{t.clientPortal.receiptHeader}</th>
