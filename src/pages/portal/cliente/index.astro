        const date = doc.created_at ? new Date(doc.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
        const meta = [doc.file_type?.toUpperCase(), fileSize, date ? `${t.clientPortal.uploaded} ${date}` : ''].filter(Boolean).join(' \u00B7 ');
        return (
          <a class="doc-row" href={doc.file_url} target="_blank" rel="noopener">
            <div class="doc-icon available">
              <svg fill="none" viewBox="0 0 24 24" stroke="#22c55e" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
