                                <td style="font-weight:600;color:#ef4444;">{formatAmount(g.amount)}</td>
                                <td style="color:#768692;">{g.date}</td>
                                <td>{g.receipt_url ? <a href={g.receipt_url} target="_blank" rel="noopener" style="color:#A4DBE8;font-weight:600;font-size:0.78rem;text-decoration:none;">{t.common.download}</a> : <span style="color:#9ba8b2;">—</span>}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </details>
                )}
              </div>
            ) : (
              <div class="empty-section">{t.clientPortal.noExpensesYet}</div>
            )}
          </div>
        </>
      )}
    </div>
    <!-- ════════════════ END MI INVERSIÓN ════════════════ -->

    <!-- ════════════════ DOCUMENTOS TAB ════════════════ -->
    <div id="panel-documents" class="pv2-panel" role="tabpanel" aria-labelledby="tab-documents">
      <div class="pv2-panel-bar">
        <button class="pv2-back-dash" data-goto-tab="dashboard">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Dashboard
        </button>
        <span style="font-size:0.85rem;font-weight:700;color:var(--navy-900);">{t.clientPortal.navDocuments}</span>
      </div>
      <div class="section-card">
        <div class="section-card-header">
          <span class="icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </span>
          {t.clientPortal.projectDocuments}
          {documents.length > 0 && <span style="margin-left:auto;font-size:0.7rem;font-weight:600;color:var(--navy-300);">{documents.length} {documents.length !== 1 ? t.clientPortal.filesPlural : t.clientPortal.fileSingular}</span>}
        </div>

        {documents.length > 0 && (
          <div class="pv2-doc-toolbar">
            <input
              type="search"
              id="pv2-doc-search"
              class="pv2-search-input"
              placeholder={t.clientPortal.searchDocPlaceholder}
              aria-label={t.clientPortal.searchDocPlaceholder}
            />
            {docTypes.length > 1 && (
              <div class="pv2-chips" role="group" aria-label={t.clientPortal.filterByType}>
                <button class="pv2-chip pv2-chip-active" data-doc-type="all">{t.clientPortal.allTypes}</button>
                {docTypes.map((type: string) => (
                  <button class="pv2-chip" data-doc-type={type}>{type.toUpperCase()}</button>
                ))}
              </div>
            )}
          </div>
        )}

        {documents.length > 0 ? (
          <div class="pv2-doc-grid" id="pv2-doc-grid">
            {documents.map((doc: any) => {
              const date = doc.created_at ? new Date(doc.created_at).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
              const typeLabel = doc.file_type?.toUpperCase() || 'DOC';
              return (
                <a
                  class="pv2-doc-card"
                  href={doc.file_url}
                  target="_blank"
                  rel="noopener"
                  data-doc-card
                  data-doc-name={doc.name?.toLowerCase()}
                  data-doc-type={doc.file_type?.toLowerCase() || ''}
                >
                  <div class="pv2-doc-card-top">
                    <div class="pv2-doc-type-icon">
                      <svg fill="none" viewBox="0 0 24 24" stroke="#22c55e" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    </div>
                    <div>
                      <div class="pv2-doc-card-name">{doc.name}</div>
                      <div class="pv2-doc-card-meta">{[typeLabel, date ? `${t.clientPortal.uploaded} ${date}` : ''].filter(Boolean).join(' · ')}</div>
                    </div>
                  </div>
                  <div class="pv2-doc-card-footer">
                    <span class="pv2-doc-badge">{t.clientPortal.available}</span>
                    <span class="pv2-doc-dl">
                      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                      {t.common.download}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="empty-section">{t.clientPortal.noDocsYet}</div>
        )}
      </div>
    </div>
    <!-- ════════════════ END DOCUMENTOS ════════════════ -->

    <!-- ════════════════ GALERÍA TAB ════════════════ -->
    {showGalleryTab && (
      <div id="panel-gallery" class="pv2-panel" role="tabpanel" aria-labelledby="tab-gallery">
        <div class="pv2-panel-bar">
          <button class="pv2-back-dash" data-goto-tab="dashboard">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Dashboard
          </button>
          <span style="font-size:0.85rem;font-weight:700;color:var(--navy-900);">{t.clientPortal.navGallery}</span>
        </div>
        <div class="section-card">
          <div class="section-card-header">
            <span class="icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </span>
            {t.clientPortal.photoGallery}
            <span style="margin-left:auto;font-size:0.7rem;font-weight:600;color:var(--navy-300);">{photos.length} {photos.length !== 1 ? t.clientPortal.photosPlural : t.clientPortal.photoSingular}</span>
          </div>

          {stagesWithPhotos.length > 1 && (
            <div class="pv2-gallery-toolbar">
              <div class="pv2-chips" role="group" aria-label={t.clientPortal.filterByStage}>
                <button class="pv2-chip pv2-chip-active" data-gallery-stage="all">{t.clientPortal.allStages}</button>
                {stagesWithPhotos.map((s: any) => (
                  <button class="pv2-chip" data-gallery-stage={s.id}>{tn(s.name)}</button>
                ))}
              </div>
            </div>
          )}

          <div class="pv2-gallery-grid" id="pv2-gallery-grid">
            {photos.map((p: any) => (
              <div class="pv2-gallery-item" data-gallery-item data-stage-id={p.stage_id}>
                <img
                  src={p.cloudinary_url}
                  alt={p.caption || p.stages?.name || t.clientPortal.altPhotoProgress}
                  loading="lazy"
                  class="pv2-gallery-img"
                />
                {p.stages?.name && <div class="pv2-gallery-caption">{tn(p.stages.name)}</div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
    <!-- ════════════════ END GALERÍA ════════════════ -->

    <!-- ════════════════ CÁMARA TAB ════════════════ -->
    {camera && (
      <div id="panel-camera" class="pv2-panel" role="tabpanel" aria-labelledby="tab-camera">
        <div class="pv2-panel-bar">
          <button class="pv2-back-dash" data-goto-tab="dashboard">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Dashboard
          </button>
          <span style="font-size:0.85rem;font-weight:700;color:var(--navy-900);">{t.clientPortal.liveCamera}</span>
        </div>
        <div class="section-card">
          <div class="section-card-header">
            <span class="icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            </span>
            {t.clientPortal.liveCamera} — {camera.app_name || 'DMSS'}
          </div>

          <div class="cam-card">
            <div class="dmss-steps">
              <div class="dmss-step"><div class="dmss-step-num">1</div><p class="dmss-step-text">{t.clientPortal.camStep1} {camera.app_name || 'DMSS'}</p></div>
              <div class="dmss-step"><div class="dmss-step-num">2</div><p class="dmss-step-text">{t.clientPortal.camStep2}</p></div>
              <div class="dmss-step"><div class="dmss-step-num">3</div><p class="dmss-step-text">{t.clientPortal.camStep3}</p></div>
              <div class="dmss-step"><div class="dmss-step-num">4</div><p class="dmss-step-text">{t.clientPortal.camStep4}</p></div>
            </div>

            <div class="cam-info">
              <div class="cam-field">
                <label>{t.clientPortal.username}</label>
                <div class="value">
                  <span id="cam-user">{camera.username}</span>
                  <button class="copy-btn" data-copy={camera.username} title={t.clientPortal.copy}>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                  </button>
                </div>
              </div>
              <div class="cam-field">
                <label>{t.clientPortal.password}</label>
                <div class="value">
                  <span id="cam-pass" data-real={camera.password}>&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
                  <button class="toggle-btn" id="toggle-pass" title={t.clientPortal.show}>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  </button>
                  <button class="copy-btn" data-copy={camera.password} title={t.clientPortal.copy}>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                  </button>
                </div>
              </div>
            </div>

            <div class="cam-apps">
              <a href={camera.app_store_url || 'https://apps.apple.com/app/dmss/id1493268178'} target="_blank" rel="noopener" class="app-badge-link">
                <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" />
              </a>
              <a href={camera.play_store_url || 'https://play.google.com/store/apps/details?id=com.mm.android.DMSS'} target="_blank" rel="noopener" class="app-badge-link gplay">
                <img src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png" alt="Get it on Google Play" />
              </a>
            </div>

            <p class="cam-note">
              {t.clientPortal.camTrouble} <a href="https://wa.me/12012109949" target="_blank" rel="noopener">WhatsApp</a>.
            </p>
          </div>
        </div>
      </div>
    )}
    <!-- ════════════════ END CÁMARA ════════════════ -->

    <footer class="portal-footer">
      &copy; 2026 Bower Homes &middot; <a href="mailto:freddy@bowerhomesfl.com">freddy@bowerhomesfl.com</a>
    </footer>
  </div>
)}

<!-- Lightbox -->
<div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label={t.clientPortal.lightboxAriaLabel}>
  <button class="lightbox-close" id="lightbox-close" aria-label={t.common.close}>&times;</button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label={t.clientPortal.lightboxPrev}>&#8249;</button>
  <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label={t.clientPortal.lightboxNext}>&#8250;</button>
  <div class="lightbox-counter" id="lightbox-counter" aria-live="polite"></div>
</div>

<div id="client-i18n" hidden
  data-copied={t.clientPortal.copied}
  data-show={t.clientPortal.show}
  data-hide={t.clientPortal.hide}
></div>

<script is:inline>
(function() {
  var i18n = document.getElementById('client-i18n').dataset;

  // ── Toast ──
  var toast = document.getElementById('toast');
  var toastTimer;
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function() { toast.classList.remove('show'); }, 2000);
  }

  // ── Logout ──
  document.getElementById('logout-btn')?.addEventListener('click', async function() {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/portal/login';
  });

  // ── Tab system ──
  var tabBtns = document.querySelectorAll('[data-tab]');
  var panels = document.querySelectorAll('.pv2-panel');

  function activateTab(tabId) {
    tabBtns.forEach(function(btn) {
      var active = btn.dataset.tab === tabId;
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach(function(panel) {
      var active = panel.id === 'panel-' + tabId;
      if (active) { panel.classList.add('pv2-active'); }
      else { panel.classList.remove('pv2-active'); }
    });
    try { history.replaceState(null, '', '#' + tabId); } catch(e) {}
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  tabBtns.forEach(function(btn) {
    btn.addEventListener('click', function() { activateTab(btn.dataset.tab); });
    btn.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        var all = Array.from(tabBtns);
        var idx = all.indexOf(btn);
        var next = e.key === 'ArrowRight'
          ? all[(idx + 1) % all.length]
          : all[(idx - 1 + all.length) % all.length];
        next.focus();
        activateTab(next.dataset.tab);
      }
    });
  });

  // Init from URL hash
  var hash = window.location.hash.replace('#', '');
  var validTabs = Array.from(tabBtns).map(function(b) { return b.dataset.tab; });
  if (hash && validTabs.indexOf(hash) !== -1) {
    activateTab(hash);
  }

  // ── Quick links & back-to-dash ──
  document.querySelectorAll('[data-goto-tab]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activateTab(btn.dataset.gotoTab);
    });
  });

  // ── Stages: list ↔ detail ──
  var stagesList = document.getElementById('pv2-stages-list');
  var stageDetail = document.getElementById('pv2-stage-detail');
  var backToStagesBtn = document.getElementById('pv2-back-to-stages');
  var stageDropdown = document.getElementById('pv2-stage-dropdown');

  function showStageDetail(stageId) {
    if (!stageDetail || !stagesList) return;
    // show matching detail
    stageDetail.querySelectorAll('[data-stage-detail]').forEach(function(d) {
      d.style.display = d.dataset.stageDetail === stageId ? '' : 'none';
    });
    stagesList.style.display = 'none';
    stageDetail.style.display = '';
    if (backToStagesBtn) backToStagesBtn.style.display = '';
    if (stageDropdown) stageDropdown.value = stageId;
  }

  function showStagesList() {
    if (!stageDetail || !stagesList) return;
    stagesList.style.display = '';
    stageDetail.style.display = 'none';
    if (backToStagesBtn) backToStagesBtn.style.display = 'none';
    if (stageDropdown) stageDropdown.value = '';
  }

  document.querySelectorAll('[data-stage-select]').forEach(function(card) {
    card.addEventListener('click', function() {
      showStageDetail(card.dataset.stageSelect);
    });
  });

  if (backToStagesBtn) {
    backToStagesBtn.addEventListener('click', showStagesList);
  }

  if (stageDropdown) {
    stageDropdown.addEventListener('change', function() {
      if (stageDropdown.value) {
        activateTab('stages');
        showStageDetail(stageDropdown.value);
      }
    });
  }

  // ── Accordion ──
  document.querySelectorAll('[data-stage-toggle]').forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      var stage = toggle.closest('[data-stage]');
      var body = stage.querySelector('.stage-body');
      if (stage.classList.contains('open')) {
        body.style.maxHeight = body.scrollHeight + 'px';
        requestAnimationFrame(function() { body.style.maxHeight = '0'; });
        stage.classList.remove('open');
      } else {
        stage.classList.add('open');
        body.style.maxHeight = body.scrollHeight + 'px';
        body.addEventListener('transitionend', function handler() {
          if (stage.classList.contains('open')) body.style.maxHeight = '800px';
          body.removeEventListener('transitionend', handler);
        });
      }
    });
  });
  document.querySelectorAll('.stage.open .stage-body').forEach(function(b) {
    b.style.maxHeight = '800px';
  });

  // ── Copy buttons ──
  document.querySelectorAll('[data-copy]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      navigator.clipboard.writeText(btn.dataset.copy).then(function() { showToast(i18n.copied); });
    });
  });

  // ── Password toggle ──
  var camPass = document.getElementById('cam-pass');
  var toggleBtn = document.getElementById('toggle-pass');
  if (camPass && toggleBtn) {
    var passVisible = false;
    toggleBtn.addEventListener('click', function() {
      passVisible = !passVisible;
      camPass.textContent = passVisible ? camPass.dataset.real : '••••••••••••';
      toggleBtn.title = passVisible ? i18n.hide : i18n.show;
      var svg = toggleBtn.querySelector('svg');
      if (passVisible) {
        svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L6.59 6.59m7.532 7.532l3.29 3.29M3 3l18 18" />';
      } else {
        svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
      }
    });
  }

  // ── Gallery filter chips ──
  var galleryChips = document.querySelectorAll('[data-gallery-stage]');
  var galleryItems = document.querySelectorAll('[data-gallery-item]');
  galleryChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      var stageId = chip.dataset.galleryStage;
      galleryChips.forEach(function(c) { c.classList.toggle('pv2-chip-active', c === chip); });
      galleryItems.forEach(function(item) {
        var show = stageId === 'all' || item.dataset.stageId === stageId;
        item.style.display = show ? '' : 'none';
      });
    });
  });

  // ── Document search + filter ──
  var docSearch = document.getElementById('pv2-doc-search');
  var docChips = document.querySelectorAll('[data-doc-type]');
  var docCards = document.querySelectorAll('[data-doc-card]');
  var activeDocType = 'all';

  function filterDocs() {
    var query = (docSearch ? docSearch.value.toLowerCase() : '');
    docCards.forEach(function(card) {
      var nameMatch = !query || (card.dataset.docName || '').indexOf(query) !== -1;
      var typeMatch = activeDocType === 'all' || (card.dataset.docType || '') === activeDocType;
      card.style.display = (nameMatch && typeMatch) ? '' : 'none';
    });
  }

  if (docSearch) docSearch.addEventListener('input', filterDocs);
  docChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      activeDocType = chip.dataset.docType;
      docChips.forEach(function(c) { c.classList.toggle('pv2-chip-active', c === chip); });
      filterDocs();
    });
  });

  // ── Lightbox ──
  (function() {
    var overlay = document.getElementById('lightbox');
    var lbImg = document.getElementById('lightbox-img');
    var lbCounter = document.getElementById('lightbox-counter');
    var currentImages = [];
    var currentIndex = 0;

    function openLightboxWith(srcs, index) {
      currentImages = srcs;
      currentIndex = index;
      showImage();
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function showImage() {
      lbImg.src = currentImages[currentIndex];
      lbCounter.textContent = (currentIndex + 1) + ' / ' + currentImages.length;
    }

    function closeLightbox() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeLightbox(); });

    document.getElementById('lightbox-prev').addEventListener('click', function(e) {
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
      showImage();
    });
    document.getElementById('lightbox-next').addEventListener('click', function(e) {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % currentImages.length;
      showImage();
    });

    document.addEventListener('keydown', function(e) {
      if (!overlay.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length; showImage(); }
      if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % currentImages.length; showImage(); }
    });

    // Stage accordion photos
    document.querySelectorAll('.stage-photos img').forEach(function(img) {
      img.addEventListener('click', function() {
        var container = img.closest('.stage-photos');
        var imgs = Array.from(container.querySelectorAll('img'));
        openLightboxWith(imgs.map(function(i) { return i.src; }), imgs.indexOf(img));
      });
    });

    // Recent photos strip
    document.querySelectorAll('.pv2-recent-img').forEach(function(img) {
      img.addEventListener('click', function() {
        var allRecent = Array.from(document.querySelectorAll('.pv2-recent-img'));
        openLightboxWith(allRecent.map(function(i) { return i.src; }), allRecent.indexOf(img));
      });
    });

    // Gallery tab photos
    document.querySelectorAll('.pv2-gallery-img').forEach(function(img) {
      img.addEventListener('click', function() {
        var visibleImgs = Array.from(document.querySelectorAll('.pv2-gallery-img')).filter(function(i) {
          return i.closest('[data-gallery-item]').style.display !== 'none';
        });
        openLightboxWith(visibleImgs.map(function(i) { return i.src; }), visibleImgs.indexOf(img));
      });
    });
  })();
})();
</script>

<!-- ══════════════ LIQUIDACIÓN MODAL ══════════════ -->
{totalLiquidacionCalc != null && (
  <>
    <canvas id="liq-confetti"></canvas>

    <div id="liq-overlay" class="liq-overlay" role="dialog" aria-modal="true" aria-labelledby="liq-title"
         data-project-id={project?.id}
         data-auto-show={showLiquidacionModal ? 'true' : 'false'}>
      <div class="liq-card" id="liq-card">

        {/* Header */}
        <div class="liq-header">
          <button class="liq-close" id="liq-close-btn" aria-label={t.common.close}>✕</button>
          <span class="liq-header-emoji">🎉</span>
          <div class="liq-header-title" id="liq-title">{t.clientPortal.liqTitle}</div>
          <div class="liq-header-sub">{t.clientPortal.liqSubtitle} {firstName}.</div>
        </div>

        <div class="liq-body">

          {/* Bloque 1 — ROI del proyecto */}
          <div class="liq-block-title">{t.clientPortal.liqBlock1}</div>
          <div class="liq-mini-grid">
            <div class="liq-mini-card">
              <div class="liq-mini-label">{t.clientPortal.salePrice}</div>
              <div class="liq-mini-value">{fmt(salePriceProyecto)}</div>
            </div>
            <div class="liq-mini-card">
              <div class="liq-mini-label">{t.clientPortal.saleExpenses}</div>
              <div class="liq-mini-value negative">
                {totalGastosVenta > 0 ? `−${fmt(totalGastosVenta)}` : fmt(totalGastosVenta)}
              </div>
            </div>
            <div class="liq-mini-card">
              <div class="liq-mini-label">{t.clientPortal.constructionExpenses}</div>
              <div class="liq-mini-value">{fmt(totalGastadoProyecto)}</div>
            </div>
            <div class="liq-mini-card">
              <div class="liq-mini-label">{t.clientPortal.gainHeader}</div>
              <div class={`liq-mini-value ${gananciaNetaProyecto != null && gananciaNetaProyecto >= 0 ? 'positive' : 'negative'}`}>
                {gananciaNetaProyecto != null ? `${gananciaNetaProyecto >= 0 ? '+' : ''}${fmt(gananciaNetaProyecto)}` : '—'}
              </div>
            </div>
            <div class="liq-mini-card">
              <div class="liq-mini-label">{t.clientPortal.projectRoiLabel}</div>
              <div class={`liq-mini-value ${roiRealCalcProyecto != null && roiRealCalcProyecto >= 0 ? 'positive' : 'negative'}`}>
                {roiRealCalcProyecto != null ? `${roiRealCalcProyecto >= 0 ? '+' : ''}${roiRealCalcProyecto}%` : '—'}
              </div>
            </div>
          </div>

          <hr class="liq-divider" />

          {/* Bloque 2 — Liquidación del inversor */}
          <div class="liq-block-title">
            {t.clientPortal.liqBlock2}{propPct != null ? ` — ${propPct}${t.clientPortal.pctOfTotalCapital}` : ''}
          </div>
          <div class="liq-block2">
            <div class="liq-row">
              <span class="liq-row-label">{t.clientPortal.committedCapital}</span>
              <span class="liq-row-val">{fmt(clientInvestmentAmount)}</span>
            </div>
            {ajusteInversorCalc != null && (
              <div class="liq-row">
                <span class="liq-row-label">
                  {ajusteInversorCalc >= 0 ? t.clientPortal.adjustmentRefund : t.clientPortal.adjustmentCall}
                </span>
                <span class={`liq-row-val ${ajusteInversorCalc >= 0 ? 'positive' : 'negative'}`}>
                  {ajusteInversorCalc >= 0 ? '+' : ''}{fmt(ajusteInversorCalc)}
                </span>
              </div>
            )}
            {gananciaInversorCalc != null && (
              <div class="liq-row">
                <span class="liq-row-label">{t.clientPortal.yourGain}</span>
                <span class={`liq-row-val ${gananciaInversorCalc >= 0 ? 'positive' : 'negative'}`}>
                  {gananciaInversorCalc >= 0 ? '+' : ''}{fmt(gananciaInversorCalc)}
                </span>
              </div>
            )}
            <div class="liq-total-row">
              <span class="liq-total-label">{t.clientPortal.totalToReceive}</span>
              <span class={`liq-total-val ${totalLiquidacionCalc != null && totalLiquidacionCalc < 0 ? 'negative' : ''}`}>
                {totalLiquidacionCalc != null ? `${totalLiquidacionCalc >= 0 ? '+' : ''}${fmt(totalLiquidacionCalc)}` : '—'}
              </span>
            </div>
            {roiRealCalc != null && (
              <div style="text-align:center;margin-top:0.6rem;">
                <div style="font-size:0.62rem;font-weight:700;text-transform:uppercase;color:#768692;margin-bottom:0.3rem;">{t.clientPortal.yourRoiReal}</div>
                <span class={`liq-roi-pill ${roiRealCalc < 0 ? 'negative' : ''}`}>
                  {roiRealCalc >= 0 ? '+' : ''}{roiRealCalc}%
                </span>
              </div>
            )}
            <p class="liq-footnote">{t.clientPortal.adjustmentNote}</p>
          </div>

          <button class="liq-cta" id="liq-cta-btn">{t.clientPortal.liqCtaBtn}</button>
        </div>
      </div>
    </div>
  </>
)}
<!-- ══════════════ END MODAL ══════════════ -->

<script>
(function() {
  // ── Confetti ──
  function launchConfetti() {
    var canvas = document.getElementById('liq-confetti');
    if (!canvas) return function(){};
    var ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.style.display = 'block';
    var colors = ['#A4DBE8','#22c55e','#ffffff','#fbbf24','#f472b6','#818cf8'];
    var particles = Array.from({length: 130}, function() {
      return {
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        r: Math.random() * 7 + 3,
        color: colors[Math.floor(Math.random() * colors.length)],
        tiltAngle: Math.random() * Math.PI * 2,
        tiltSpeed: Math.random() * 0.07 + 0.04,
        vx: Math.random() * 2.5 - 1.25,
        vy: Math.random() * 2.5 + 1.5,
        shape: Math.random() > 0.5 ? 'rect' : 'circle',
      };
    });
    var frame, tick = 0;
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(function(p) {
        p.tiltAngle += p.tiltSpeed;
        p.y += p.vy;
        p.x += p.vx;
        var tilt = Math.sin(p.tiltAngle) * 12;
        ctx.beginPath();
        ctx.fillStyle = p.color;
        if (p.shape === 'circle') {
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        } else {
          ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.tiltAngle);
          ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
          ctx.restore(); return;
        }
        ctx.fill();
      });
      tick++;
      if (tick < 250) { frame = requestAnimationFrame(draw); }
      else { canvas.style.display = 'none'; }
    }
    draw();
    return function() { if (frame) cancelAnimationFrame(frame); canvas.style.display = 'none'; };
  }

  // ── Modal logic ──
  var overlay = document.getElementById('liq-overlay');
  if (!overlay) return;

  var projectId = overlay.dataset.projectId;
  var autoShow  = overlay.dataset.autoShow === 'true';
  var stopConfetti = function(){};

  function openModal() {
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    stopConfetti = launchConfetti();
  }

  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    stopConfetti();
  }

  // Mark as seen (fire-and-forget)
  function markSeen() {
    if (!projectId) return;
    fetch('/api/portal/mark-liquidacion-vista', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ project_id: projectId }),
    }).catch(function() {});
  }

  // Auto-open once
  if (autoShow) {
    setTimeout(function() { openModal(); markSeen(); }, 600);
  }

  // Close button
  var closeBtn = document.getElementById('liq-close-btn');
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  // CTA button
  var ctaBtn = document.getElementById('liq-cta-btn');
  if (ctaBtn) ctaBtn.addEventListener('click', closeModal);

  // Backdrop click
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeModal();
  });

  // ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  // Reopen button
  var reopenBtn = document.getElementById('liq-reopen-btn');
  if (reopenBtn) {
    reopenBtn.addEventListener('click', function() { openModal(); });
  }
})();
</script>

</body>
</html>
