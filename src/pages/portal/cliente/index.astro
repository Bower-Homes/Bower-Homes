          <div class="stat-card">
            <p class="stat-label">{t.clientPortal.roiReal}</p>
            <p class="stat-value" style={roiReal != null && roiReal >= 0 ? 'color:#22c55e;' : roiReal != null ? 'color:#ef4444;' : ''}>{roiReal != null ? roiReal + '%' : '—'}</p>
            {roiReal != null && clientInvestmentAmount && <p class="stat-sub">{t.clientPortal.gainLabel} {formatAmount(clientInvestmentAmount * roiReal / 100)}</p>}
          </div>
          <div class="stat-card">
            <p class="stat-label">{t.clientPortal.totalReturned}</p>
            <p class="stat-value">{formatAmount(totalRetornado)}</p>
