                {termsStatus === 'activo' ? t.clientPortal.statusActive : termsStatus === 'en_retorno' ? t.clientPortal.statusInReturn : t.clientPortal.statusSettled}
              </span>
            </p>
          </div>
        </div>

        {myTransactions.length > 0 ? (
          <div>
