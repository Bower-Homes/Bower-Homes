        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#9ba8b2;padding:1.5rem;">' + i18n.noMovements + '</td></tr>';
      } else {
        txData.forEach(function(tx) {
          if (tx.type === 'aporte') totalAportado += Number(tx.amount) || 0;
