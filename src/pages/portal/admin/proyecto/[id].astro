            '<td style="font-weight:600;">$' + Number(tx.amount).toLocaleString() + '</td>' +
            '<td style="color:var(--navy-400);font-size:0.8rem;">' + (tx.date || '') + '</td>' +
            '<td style="color:var(--navy-400);font-size:0.8rem;">' + (tx.payment_method || '—') + '</td>' +
            '<td>' + receiptHtml + '</td>' +
            '<td style="color:var(--navy-400);font-size:0.8rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + (tx.notes || '—') + '</td>' +
