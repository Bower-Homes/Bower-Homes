    if (!pendingPhotos.length) return;

    this.disabled = true;
    this.innerHTML = '<div class="spinner"></div> ' + i18n.uploading;
    var uploaded = 0;

    for (var i = 0; i < pendingPhotos.length; i++) {
      try {
        var pf = pendingPhotos[i];
        var fd = new FormData();
        fd.append('file', pf, pf.name || ('photo_' + Date.now() + '_' + i + '.webp'));
        fd.append('folder', 'bower/fotos');
        fd.append('projectName', projectName);
        var upRes = await fetch('/api/upload', { method: 'POST', body: fd });
        var upData = await upRes.json();
        if (!upRes.ok) throw new Error(upData.error);

        var saveRes = await fetch('/api/admin/photos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            project_id: projectId,
            stage_id: stageId,
            cloudinary_url: upData.url,
            cloudinary_public_id: upData.public_id,
          }),
        });
        if (!saveRes.ok) throw new Error((await saveRes.json()).error);
        uploaded++;
      } catch(e) {
        window.showToast('Error subiendo foto ' + (i+1) + ': ' + e.message, 'error');
      }
    }

    window.showToast(uploaded + ' ' + i18n.photosUploaded, 'success');
    pendingPhotos = [];
    setTimeout(function() { location.reload(); }, 500);
  });

