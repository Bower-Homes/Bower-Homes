  // ── TAB: PHOTOS ──
  function convertToWebP(file, quality) {
    quality = quality || 0.82;
    return new Promise(function(resolve) {
      var canvas = document.createElement('canvas');
      var ctx = canvas.getContext('2d');
      var img = new Image();
      var url = URL.createObjectURL(file);
      img.onload = function() {
        var maxWidth = 1920;
        var scale = img.width > maxWidth ? maxWidth / img.width : 1;
        canvas.width = img.width * scale;
        canvas.height = img.height * scale;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        URL.revokeObjectURL(url);
        canvas.toBlob(function(blob) {
          var newName = file.name.replace(/\.[^.]+$/, '.webp');
          var webpFile = new File([blob], newName, { type: 'image/webp' });
          resolve(webpFile);
        }, 'image/webp', quality);
      };
      img.src = url;
    });
  }

  function convertMultipleToWebP(files, quality, onProgress) {
    quality = quality || 0.82;
    var fileArray = Array.from(files);
    var converted = [];
    return (async function() {
      for (var i = 0; i < fileArray.length; i++) {
        var file = fileArray[i];
        if (file.type.startsWith('image/')) {
          converted.push(await convertToWebP(file, quality));
        } else {
          converted.push(file);
        }
        if (onProgress) onProgress(i + 1, fileArray.length);
      }
      return converted;
    })();
  }

  var pendingPhotos = [];
  document.getElementById('photo-file-input')?.addEventListener('change', async function() {
    var files = Array.from(this.files);
    if (!files.length) return;
    var preview = document.getElementById('photo-upload-preview');
    var grid = document.getElementById('photo-previews');
    var info = document.getElementById('photo-upload-info');
    preview.style.display = 'block';
    grid.innerHTML = '';
    pendingPhotos = [];
    info.textContent = i18n.converting + ' 0/' + files.length;

    var converted = await convertMultipleToWebP(files, 0.82, function(current, total) {
      info.textContent = i18n.converting + ' ' + current + '/' + total;
    });

    pendingPhotos = converted;

    for (var i = 0; i < converted.length; i++) {
      var f = converted[i];
      var url = URL.createObjectURL(f);
      var div = document.createElement('div');
      div.innerHTML = '<img src="' + url + '" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:0.5rem;border:1px solid #dce0ea;" />' +
        '<div style="font-size:0.7rem;color:#9ba8b2;margin-top:0.25rem;">' + (f.size / 1024).toFixed(0) + ' KB · WebP</div>';
      grid.appendChild(div);
    }

    var totalSize = pendingPhotos.reduce(function(s, f) { return s + f.size; }, 0);
    info.textContent = pendingPhotos.length + ' ' + i18n.photosReady + ' · ' + (totalSize / 1024 / 1024).toFixed(1) + ' MB total (WebP)';
    this.value = '';
  });

  document.getElementById('upload-photos-btn')?.addEventListener('click', async function() {
    var stageId = document.getElementById('photo-stage-select').value;
