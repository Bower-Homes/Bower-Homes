---
export const prerender = false;
import AdminLayout from '../../../components/portal/AdminLayout.astro';
import { createSupabaseAdmin } from '../../../lib/supabase';
import { getPortalT } from '../../../i18n/portal';

const lang = (Astro.locals as any).lang || 'es';
const t = getPortalT(lang);

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

const supabase = createSupabaseAdmin();

const { count: totalProjects } = await supabase.from('projects').select('*', { count: 'exact', head: true });
const { count: activeProjects } = await supabase.from('projects').select('*', { count: 'exact', head: true }).eq('status', 'active');
const { count: totalClients } = await supabase.from('profiles').select('*', { count: 'exact', head: true }).eq('role', 'client').eq('active', true);

const { data: recentProjects } = await supabase
  .from('projects')
  .select('*, project_clients(client_id, profiles:client_id(full_name)), stages(progress)')
  .order('created_at', { ascending: false })
  .limit(5);

function calcProgress(stages: any[]) {
  if (!stages?.length) return 0;
  return Math.round(stages.reduce((s: number, st: any) => s + (st.progress || 0), 0) / stages.length);
}
---
<AdminLayout title={t.layout.dashboard} user={user} activeNav="dashboard" lang={lang}>
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon gold">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
      </div>
      <div class="stat-label">{t.dashboard.totalProjects}</div>
      <div class="stat-value gold">{totalProjects || 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon blue">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      </div>
      <div class="stat-label">{t.dashboard.activeProjects}</div>
      <div class="stat-value">{activeProjects || 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
      <div class="stat-label">{t.dashboard.activeClients}</div>
      <div class="stat-value">{totalClients || 0}</div>
    </div>
  </div>

  <div class="card" style="margin-bottom:2rem;">
    <div class="card-header">
      <span>{t.dashboard.recentProjects}</span>
      <a href="/portal/admin/proyectos" class="btn btn-primary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        {t.dashboard.newProject}
      </a>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>{t.dashboard.project}</th>
            <th>{t.dashboard.client}</th>
            <th>{t.common.status}</th>
            <th>{t.dashboard.progress}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {(!recentProjects || recentProjects.length === 0) ? (
            <tr><td colspan="5">
              <div class="empty-state">
                <div class="empty-state-icon">
                  <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                </div>
                <p>{t.dashboard.noProjectsYet}</p>
                <small>{t.dashboard.noProjectsSub}</small>
              </div>
            </td></tr>
          ) : recentProjects.map((p: any) => {
            const client = p.project_clients?.[0]?.profiles?.full_name || '—';
            const progress = calcProgress(p.stages);
            const statusClass = p.status === 'active' ? 'badge-active' : p.status === 'completed' ? 'badge-completed' : 'badge-paused';
            const statusLabel = p.status === 'active' ? t.common.active : p.status === 'completed' ? t.common.completed : t.common.paused;
            return (
              <tr>
                <td style="font-weight:600;">{p.name}</td>
                <td style="color:var(--navy-400);">{client}</td>
                <td><span class={`badge ${statusClass}`}>{statusLabel}</span></td>
                <td>
                  <div style="display:flex;align-items:center;gap:0.6rem;">
                    <div class="progress-bar">
                      <div class={`progress-fill ${progress >= 100 ? 'green' : 'gold'}`} style={`width:${progress}%;`}></div>
                    </div>
                    <span style="font-size:0.75rem;font-weight:700;color:var(--navy-400);min-width:32px;">{progress}%</span>
                  </div>
                </td>
                <td>
                  <a href={`/portal/admin/proyecto/${p.id}`} class="btn btn-secondary btn-sm">{t.dashboard.view}</a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
    <a href="/portal/admin/usuarios" class="quick-action">
      <div class="quick-action-icon">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      </div>
      <div>
        <div class="quick-action-title">{t.dashboard.createClient}</div>
        <div class="quick-action-desc">{t.dashboard.createClientDesc}</div>
      </div>
    </a>
    <a href="/portal/admin/proyectos" class="quick-action">
      <div class="quick-action-icon">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
      </div>
      <div>
        <div class="quick-action-title">{t.dashboard.createProject}</div>
        <div class="quick-action-desc">{t.dashboard.createProjectDesc}</div>
      </div>
    </a>
  </div>
</AdminLayout>
