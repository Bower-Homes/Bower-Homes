---
const pillars = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>`,
    title: 'Capital alineado',
    desc: 'Bower invierte su propio capital en cada proyecto. Nuestros intereses son exactamente los mismos que los tuyos: maximizar el valor de la propiedad.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
    </svg>`,
    title: 'Rentabilidad comprobada',
    desc: 'ROI de 12% a 20% anual en proyectos de construcción de Single Family Homes, un mercado con demanda sostenida y crecimiento constante.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
    </svg>`,
    title: 'Transparencia total',
    desc: 'Acceso a reportes de avance, fotos y estados financieros actualizados. Sabés exactamente dónde está tu inversión en todo momento.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>`,
    title: 'Florida: el mercado ideal',
    desc: 'Sin impuesto estatal, crecimiento poblacional récord y demanda de vivienda que supera consistentemente la oferta. El contexto perfecto para invertir.',
  },
];
---

<section id="por-que" class="py-24 bg-blue-50">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="reveal inline-block text-sky-500 font-semibold text-sm tracking-widest uppercase mb-3">
        Nuestras ventajas
      </div>
      <h2 class="reveal delay-100 section-title mb-4">
        Por qué elegir Bower Homes
      </h2>
      <p class="reveal delay-200 text-blue-700/60 max-w-xl mx-auto leading-relaxed">
        No somos un fondo genérico. Somos constructores que también invierten,
        con foco exclusivo en el mercado de Florida.
      </p>
    </div>

    <!-- 2x2 Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {pillars.map((p, i) => (
        <div class={`reveal delay-${i * 100} bg-white rounded-2xl p-8 border border-blue-100 hover:border-sky-300 hover:shadow-lg transition-all duration-300 group`}>
          <div class="w-14 h-14 bg-sky-400/10 text-sky-500 rounded-xl flex items-center justify-center mb-5 group-hover:bg-sky-400 group-hover:text-white transition-all duration-300">
            <Fragment set:html={p.icon} />
          </div>
          <h3 class="font-heading text-xl font-bold text-blue-900 mb-3">{p.title}</h3>
          <p class="text-blue-700/60 leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
