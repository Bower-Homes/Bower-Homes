---
---
<section id="contacto" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start">
    <!-- LEFT: Info -->
    <div>
      <div class="reveal inline-block text-sky-500 font-semibold text-sm tracking-widest uppercase mb-3">
        Contacto
      </div>
      <h2 class="reveal delay-100 section-title mb-4">
        Hablemos de tu inversión
      </h2>
      <p class="reveal delay-200 text-blue-700/60 leading-relaxed mb-10">
        ¿Listo para dar el primer paso? Cuéntanos tu perfil, tus objetivos y cuánto
        capital tienes disponible. Te respondemos en menos de 24 horas.
      </p>

      <!-- Contact cards -->
      <div class="reveal delay-300 space-y-4 mb-8">
        <a
          href="mailto:freddy@bowerhomesfl.com"
          class="flex items-center gap-4 p-5 rounded-xl border border-blue-100 hover:border-sky-300 hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-12 h-12 bg-sky-400/10 rounded-xl flex items-center justify-center text-sky-500 group-hover:bg-sky-400 group-hover:text-white transition-all duration-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-blue-400 uppercase tracking-wider">Email</div>
            <div class="font-semibold text-blue-900 mt-0.5">freddy@bowerhomesfl.com</div>
          </div>
        </a>

        <a
          href="https://wa.me/12012109949"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-5 rounded-xl border border-blue-100 hover:border-[#25D366] hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-500 group-hover:bg-[#25D366] group-hover:text-white transition-all duration-200">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs text-blue-400 uppercase tracking-wider">WhatsApp</div>
            <div class="font-semibold text-blue-900 mt-0.5">+1 (201) 210-9949</div>
          </div>
        </a>

        <div class="flex items-center gap-4 p-5 rounded-xl border border-blue-100">
          <div class="w-12 h-12 bg-sky-400/10 rounded-xl flex items-center justify-center text-sky-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-blue-400 uppercase tracking-wider">Ubicación</div>
            <div class="font-semibold text-blue-900 mt-0.5">Southwest Florida, USA</div>
          </div>
        </div>
      </div>

      <!-- WhatsApp CTA -->
      <div class="reveal delay-400">
        <a
          href={`https://wa.me/12012109949?text=${encodeURIComponent('Hola Freddy, me interesa conocer más sobre las oportunidades de inversión de Bower Homes.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#25D366] text-white font-semibold px-6 py-4 rounded-xl hover:bg-[#22c55e] transition-colors duration-200 shadow-lg shadow-emerald-200"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribir por WhatsApp ahora
        </a>
      </div>
    </div>

    <!-- RIGHT: Form -->
    <div class="reveal delay-300">
      <div class="bg-blue-50 rounded-2xl p-8 border border-blue-100">
        <h3 class="font-heading text-xl font-bold text-blue-900 mb-6">Envíanos un mensaje</h3>

        <form id="contact-form" class="space-y-5">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-blue-700 mb-1.5" for="name">Nombre</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Tu nombre"
                class="w-full bg-white border border-blue-200 rounded-xl px-4 py-3 text-sm text-blue-900 placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition-all duration-200"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-blue-700 mb-1.5" for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="tu@email.com"
                class="w-full bg-white border border-blue-200 rounded-xl px-4 py-3 text-sm text-blue-900 placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition-all duration-200"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-blue-700 mb-1.5" for="phone">Teléfono / WhatsApp</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="+1 (000) 000-0000"
              class="w-full bg-white border border-blue-200 rounded-xl px-4 py-3 text-sm text-blue-900 placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition-all duration-200"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-blue-700 mb-1.5" for="product">¿Qué te interesa?</label>
            <select
              id="product"
              name="product"
              class="w-full bg-white border border-blue-200 rounded-xl px-4 py-3 text-sm text-blue-900 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition-all duration-200"
            >
              <option value="">Selecciona una opción</option>
              <option value="colectiva">Inversión Colectiva</option>
              <option value="llaveenmano">Llave en Mano</option>
              <option value="info">Solo quiero información</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-blue-700 mb-1.5" for="message">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Cuéntanos sobre tu perfil de inversión, capital disponible, preguntas..."
              class="w-full bg-white border border-blue-200 rounded-xl px-4 py-3 text-sm text-blue-900 placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-transparent transition-all duration-200 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full flex items-center justify-center gap-3 bg-sky-400 hover:bg-sky-500 active:bg-sky-600 disabled:opacity-50 disabled:cursor-not-allowed text-blue-900 font-bold text-base py-4 rounded-xl shadow-md shadow-sky-400/30 hover:shadow-sky-500/40 transition-all duration-200"
            aria-label="Enviar consulta de inversión"
          >
            <!-- Spinner (oculto por defecto) -->
            <svg id="submit-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
            <span id="submit-text">Quiero que me contacten</span>
            <svg id="submit-arrow" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
          <p class="text-center text-xs text-blue-400 mt-2">
            Respondemos en menos de 24h · Tu información es confidencial
          </p>
        </form>

        <!-- Success message -->
        <div id="success-msg" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-700 text-sm text-center">
          ¡Mensaje enviado! Te contactaremos pronto.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const submitArrow = document.getElementById('submit-arrow');
  const submitSpinner = document.getElementById('submit-spinner');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Loading state
    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = 'Enviando...';
    submitArrow?.classList.add('hidden');
    submitSpinner?.classList.remove('hidden');

    const data = new FormData(form);
    const name = data.get('name') as string;
    const product = data.get('product') as string;
    const message = data.get('message') as string;

    const waText = `Hola Freddy! Soy ${name || 'un interesado'}. Me interesa: ${product || 'más información'}.${message ? `\n\n${message}` : ''}`.trim();

    // Breve delay para feedback visual antes de abrir WhatsApp
    setTimeout(() => {
      window.open(`https://wa.me/12012109949?text=${encodeURIComponent(waText)}`, '_blank');

      if (submitText) submitText.textContent = '¡Listo! Abrimos WhatsApp';
      submitSpinner?.classList.add('hidden');
      submitArrow?.classList.remove('hidden');
      form.reset();

      setTimeout(() => {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Quiero que me contacten';
      }, 4000);
    }, 600);
  });
</script>
