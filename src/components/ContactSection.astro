---
import { t } from '../i18n/landing';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const tx = t[lang].contact;

// Strings passed to client-side script
const scriptVars = {
  submitLoading: tx.submitLoading,
  submitSuccess: tx.submitSuccess,
  errNombre: tx.errNombre,
  errContacto: tx.errContacto,
  errOpcion: tx.errOpcion,
  waTemplate: tx.waTemplate,
  msgToggleLabel: tx.msgToggle,
};
---
<section id="contacto" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start">

    <!-- LEFT: Info de contacto -->
    <div>
      <div class="reveal inline-block text-bower-primary font-semibold text-sm tracking-widest uppercase mb-3">
        {tx.eyebrow}
      </div>
      <h2 class="reveal delay-100 section-title mb-4">
        {tx.h2}
      </h2>
      <p class="reveal delay-200 text-bower-primary/80 leading-relaxed mb-10">
        {tx.sub}
      </p>

      <!-- Cards de contacto -->
      <div class="reveal delay-300 space-y-4 mb-8">
        <a
          href="mailto:freddy@bowerhomesfl.com"
          class="flex items-center gap-4 p-5 rounded-xl border border-bower-gray-light hover:border-bower-primary hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-12 h-12 bg-bower-primary/10 rounded-xl flex items-center justify-center text-bower-primary group-hover:bg-bower-primary group-hover:text-white transition-all duration-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wider">{tx.emailLabel}</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">freddy@bowerhomesfl.com</div>
          </div>
        </a>

        <a
          href="https://wa.me/12012109949"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-5 rounded-xl border border-bower-gray-light hover:border-[#25D366] hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-500 group-hover:bg-[#25D366] group-hover:text-white transition-all duration-200">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wider">{tx.waLabel}</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">+1 (201) 210-9949</div>
          </div>
        </a>

        <div class="flex items-center gap-4 p-5 rounded-xl border border-bower-gray-light">
          <div class="w-12 h-12 bg-bower-primary/10 rounded-xl flex items-center justify-center text-bower-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wider">{tx.locationLabel}</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">Southwest Florida, USA</div>
          </div>
        </div>
      </div>

      <!-- WA CTA directo -->
      <div class="reveal delay-400">
        <a
          href={`https://wa.me/12012109949?text=${encodeURIComponent(tx.waCtaMsg)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#25D366] text-white font-semibold px-6 py-4 rounded-xl hover:bg-[#22c55e] transition-colors duration-200 shadow-lg shadow-emerald-200"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {tx.waCtaBtn}
        </a>
      </div>
    </div>

    <!-- RIGHT: Formulario -->
    <div class="reveal delay-300">
      <div class="bg-bower-gray-light/20 rounded-2xl p-8 border border-bower-gray-light">
        <h3 class="font-heading text-xl font-bold text-bower-primary-dark mb-1">{tx.formTitle}</h3>
        <p class="text-bower-primary/80 text-sm mb-7">{tx.formSub}</p>

        <form id="contact-form" novalidate class="space-y-6">

          <!-- Nombre -->
          <div>
            <label class="block text-sm font-semibold text-bower-primary-dark mb-1.5" for="cf-nombre">
              {tx.nameLabel} <span class="text-bower-primary">*</span>
            </label>
            <input
              id="cf-nombre"
              name="nombre"
              type="text"
              autocomplete="given-name"
              placeholder={tx.namePlaceholder}
              class="cf-input w-full bg-white border border-bower-gray-light rounded-xl px-4 py-3 text-sm text-bower-primary-dark placeholder-bower-gray-blue focus:outline-none focus:ring-2 focus:ring-bower-primary focus:border-transparent transition-all duration-200"
              aria-describedby="err-nombre"
            />
            <p id="err-nombre" class="cf-error hidden mt-1.5 text-xs text-red-500 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <span>{tx.errNombre}</span>
            </p>
          </div>

          <!-- Email o WA -->
          <div>
            <label class="block text-sm font-semibold text-bower-primary-dark mb-1.5" for="cf-contacto">
              {tx.contactLabel} <span class="text-bower-primary">*</span>
            </label>
            <input
              id="cf-contacto"
              name="contacto"
              type="text"
              autocomplete="email"
              placeholder={tx.contactPlaceholder}
              class="cf-input w-full bg-white border border-bower-gray-light rounded-xl px-4 py-3 text-sm text-bower-primary-dark placeholder-bower-gray-blue focus:outline-none focus:ring-2 focus:ring-bower-primary focus:border-transparent transition-all duration-200"
              aria-describedby="err-contacto"
            />
            <p id="err-contacto" class="cf-error hidden mt-1.5 text-xs text-red-500 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <span>{tx.errContacto}</span>
            </p>
          </div>

          <!-- Tipo de inversión -->
          <fieldset>
            <legend class="block text-sm font-semibold text-bower-primary-dark mb-3">
              {tx.interestLabel} <span class="text-bower-primary">*</span>
            </legend>
            <div class="flex flex-wrap gap-2" role="group" aria-describedby="err-tipo">
              {tx.interestOptions.map(({ value, label }) => (
                <label class="radio-chip cursor-pointer">
                  <input type="radio" name="tipo" value={value} class="sr-only peer" />
                  <span class="inline-flex items-center px-4 py-2.5 rounded-xl border border-bower-gray-light bg-white text-sm text-bower-primary font-medium peer-checked:bg-bower-primary peer-checked:text-white peer-checked:border-bower-primary hover:border-bower-accent-light transition-all duration-150 select-none">
                    {label}
                  </span>
                </label>
              ))}
            </div>
            <p id="err-tipo" class="cf-error hidden mt-1.5 text-xs text-red-500 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <span>{tx.errOpcion}</span>
            </p>
          </fieldset>

          <!-- Capital -->
          <fieldset>
            <legend class="block text-sm font-semibold text-bower-primary-dark mb-3">
              {tx.capitalLabel} <span class="text-bower-primary">*</span>
            </legend>
            <div class="flex flex-wrap gap-2" role="group" aria-describedby="err-monto">
              {tx.capitalOptions.map(({ value, label }) => (
                <label class="radio-chip cursor-pointer">
                  <input type="radio" name="monto" value={value} class="sr-only peer" />
                  <span class="inline-flex items-center px-4 py-2.5 rounded-xl border border-bower-gray-light bg-white text-sm text-bower-primary font-medium peer-checked:bg-bower-primary peer-checked:text-white peer-checked:border-bower-primary hover:border-bower-accent-light transition-all duration-150 select-none">
                    {label}
                  </span>
                </label>
              ))}
            </div>
            <p id="err-monto" class="cf-error hidden mt-1.5 text-xs text-red-500 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <span>{tx.errOpcion}</span>
            </p>
          </fieldset>

          <!-- Mensaje colapsable -->
          <div>
            <button
              type="button"
              id="toggle-msg"
              class="flex items-center gap-2 text-bower-primary hover:text-bower-primary/80 text-sm font-semibold transition-colors duration-150"
              aria-expanded="false"
              aria-controls="msg-area"
            >
              <svg id="toggle-icon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
              {tx.msgToggle}
            </button>
            <div id="msg-area" class="hidden mt-3">
              <textarea
                id="cf-mensaje"
                name="mensaje"
                rows="3"
                placeholder={tx.msgPlaceholder}
                class="w-full bg-white border border-bower-gray-light rounded-xl px-4 py-3 text-sm text-bower-primary-dark placeholder-bower-gray-blue focus:outline-none focus:ring-2 focus:ring-bower-primary focus:border-transparent transition-all duration-200 resize-none"
                aria-label="Optional additional message"
              ></textarea>
            </div>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full flex items-center justify-center gap-3 font-bold text-base py-4 rounded-xl shadow-md transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
            style="background:#D9B48F;color:#041E42;"
            onmouseover="if(!this.disabled)this.style.background='#c9a07f'"
            onmouseout="this.style.background='#D9B48F'"
          >
            <svg id="submit-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
            <span id="submit-text">{tx.submitBtn}</span>
            <svg id="submit-arrow" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
          <p class="text-center text-xs text-bower-primary/80 mt-1">
            {tx.submitNote}
          </p>

        </form>
      </div>
    </div>

  </div>
</section>

<script define:vars={scriptVars}>
  // ── Toggle mensaje colapsable ──────────────────────────────────────────────
  const toggleBtn  = document.getElementById('toggle-msg');
  const msgArea    = document.getElementById('msg-area');
  const toggleIcon = document.getElementById('toggle-icon');

  toggleBtn?.addEventListener('click', () => {
    const open = msgArea?.classList.toggle('hidden') === false;
    toggleBtn.setAttribute('aria-expanded', String(open));
    toggleIcon?.classList.toggle('rotate-45', open);
  });

  // ── Validación ────────────────────────────────────────────────────────────
  const form = document.getElementById('contact-form');

  function showError(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('hidden');
    el.classList.add('flex');
  }
  function clearError(id) {
    const el = document.getElementById(id);
    el?.classList.add('hidden');
    el?.classList.remove('flex');
  }

  function isValidContact(val) {
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const phoneRe = /^[\+\d][\d\s\(\)\-]{5,}$/;
    return emailRe.test(val.trim()) || phoneRe.test(val.trim());
  }

  document.getElementById('cf-nombre')?.addEventListener('blur', (e) => {
    const val = e.target.value.trim();
    val.length >= 2 ? clearError('err-nombre') : showError('err-nombre');
  });
  document.getElementById('cf-contacto')?.addEventListener('blur', (e) => {
    isValidContact(e.target.value) ? clearError('err-contacto') : showError('err-contacto');
  });

  // ── Submit ─────────────────────────────────────────────────────────────────
  const submitBtn     = document.getElementById('submit-btn');
  const submitText    = document.getElementById('submit-text');
  const submitArrow   = document.getElementById('submit-arrow');
  const submitSpinner = document.getElementById('submit-spinner');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nombre   = form.querySelector('[name="nombre"]')?.value.trim();
    const contacto = form.querySelector('[name="contacto"]')?.value.trim();
    const tipo     = form.querySelector('[name="tipo"]:checked')?.value;
    const monto    = form.querySelector('[name="monto"]:checked')?.value;
    const mensaje  = form.querySelector('[name="mensaje"]')?.value.trim();

    let valid = true;
    if (!nombre || nombre.length < 2) { showError('err-nombre'); valid = false; }
    else clearError('err-nombre');

    if (!isValidContact(contacto)) { showError('err-contacto'); valid = false; }
    else clearError('err-contacto');

    if (!tipo)  { showError('err-tipo');  valid = false; } else clearError('err-tipo');
    if (!monto) { showError('err-monto'); valid = false; } else clearError('err-monto');

    if (!valid) {
      form.querySelector('.cf-error:not(.hidden)')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = submitLoading;
    submitArrow?.classList.add('hidden');
    submitSpinner?.classList.remove('hidden');

    // Build WA message from template
    let waText = waTemplate
      .replace('{nombre}', nombre)
      .replace('{tipo}', tipo)
      .replace('{monto}', monto)
      .replace('{contacto}', contacto);
    if (mensaje) waText += '\n\n' + mensaje;

    setTimeout(() => {
      window.open(`https://wa.me/12012109949?text=${encodeURIComponent(waText)}`, '_blank');

      if (submitText) submitText.textContent = submitSuccess;
      submitSpinner?.classList.add('hidden');
      submitArrow?.classList.remove('hidden');
      form.reset();
      msgArea?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleIcon?.classList.remove('rotate-45');

      setTimeout(() => {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = submitText.dataset.original || submitText.textContent;
      }, 4000);
    }, 500);
  });
</script>
