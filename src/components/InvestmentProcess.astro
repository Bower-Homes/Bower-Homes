---
const steps = [
  {
    number: '01',
    title: 'Primer contacto',
    desc: 'Nos escribes por teléfono, WhatsApp o email. Conversamos sobre tu perfil, objetivos y capital disponible para encontrar la opción que mejor se adapte a ti.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="M28 16c0 6.627-5.373 12-12 12a11.955 11.955 0 01-6.071-1.64L4 28l1.653-5.821A11.955 11.955 0 014 16C4 9.373 9.373 4 16 4s12 5.373 12 12z"/>
      <circle cx="11" cy="16" r="1" fill="currentColor" stroke="none"/>
      <circle cx="16" cy="16" r="1" fill="currentColor" stroke="none"/>
      <circle cx="21" cy="16" r="1" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    number: '02',
    title: 'Revisión del proyecto',
    desc: 'Te presentamos el proyecto disponible: ubicación, planos, proyección de rentabilidad, cronograma y estructura legal. Sin letra chica.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="3" width="20" height="26" rx="1"/>
      <line x1="10" y1="9" x2="22" y2="9"/>
      <line x1="10" y1="14" x2="22" y2="14"/>
      <line x1="10" y1="19" x2="17" y2="19"/>
      <line x1="6" y1="3" x2="6" y2="29"/>
      <line x1="10" y1="3" x2="10" y2="7"/>
      <line x1="22" y1="3" x2="22" y2="7"/>
      <line x1="10" y1="5" x2="22" y2="5"/>
    </svg>`,
  },
  {
    number: '03',
    title: 'Firma del acuerdo',
    desc: 'Firmamos el contrato de participación. Todo queda documentado legalmente bajo la normativa de Florida, protegiendo tu inversión desde el día uno.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 4H8a1 1 0 00-1 1v22a1 1 0 001 1h16a1 1 0 001-1V10l-5-6z"/>
      <path d="M20 4v6h5"/>
      <path d="M11 20c1-2 3-3 4-1s3 1 4-1"/>
      <line x1="11" y1="15" x2="21" y2="15"/>
    </svg>`,
  },
  {
    number: '04',
    title: 'Transferencia de capital',
    desc: 'Realizas la transferencia a la cuenta del proyecto y damos inicio oficial a la construcción.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="8" width="26" height="18" rx="1.5"/>
      <line x1="3" y1="13" x2="29" y2="13"/>
      <circle cx="9" cy="20" r="2"/>
      <line x1="14" y1="20" x2="22" y2="20"/>
      <line x1="14" y1="23" x2="19" y2="23"/>
      <path d="M20 4l-4-1-4 1"/>
    </svg>`,
  },
  {
    number: '05',
    title: 'Seguimiento en tiempo real',
    desc: 'Accedes a reportes fotográficos, estados de avance y actualizaciones financieras durante toda la construcción. Tu inversión siempre a la vista.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="26" height="19" rx="1.5"/>
      <line x1="11" y1="24" x2="11" y2="28"/>
      <line x1="21" y1="24" x2="21" y2="28"/>
      <line x1="7" y1="28" x2="25" y2="28"/>
      <polyline points="7,18 11,13 15,16 20,10 25,14"/>
      <circle cx="25" cy="14" r="1.5" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    number: '06',
    title: 'Retorno de inversión',
    desc: 'Vendida la propiedad, se distribuyen las ganancias según lo acordado. Recibís tu capital más el retorno en el plazo establecido.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="16" cy="16" r="12"/>
      <path d="M16 9v2m0 10v2"/>
      <path d="M12 12.5a3.5 2.5 0 110 0zM12 12.5h8M12 12.5c0 2 1.5 2.5 4 2.5s4 .5 4 2.5a3.5 2.5 0 11-8 0h8"/>
    </svg>`,
  },
];
---

<section id="proceso" class="py-24 bg-bower-gray-light/30 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="reveal inline-block text-bower-primary font-semibold text-sm tracking-widest uppercase mb-3">
        Cómo funciona
      </div>
      <h2 class="reveal delay-100 section-title mb-4">
        Pasos para invertir
      </h2>
      <p class="reveal delay-200 text-bower-primary/80 max-w-xl mx-auto leading-relaxed">
        Un proceso claro, sin sorpresas. Desde el primer contacto hasta recibir
        tu retorno, siempre sabrás exactamente en qué etapa está tu inversión.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden lg:block absolute top-10 left-0 right-0 h-px bg-gradient-to-r from-transparent via-bower-accent-light/50 to-transparent pointer-events-none"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {steps.map((step, i) => (
          <div class={`reveal delay-${(i % 3) * 100} relative bg-white rounded-2xl p-6 border border-bower-gray-light hover:border-bower-accent-light hover:shadow-lg transition-all duration-300 group`}>
            <!-- Step number + icon row -->
            <div class="flex items-start justify-between mb-5">
              <span class="font-heading text-4xl font-bold text-bower-gray-light group-hover:text-bower-accent-light transition-colors duration-300 leading-none select-none">
                {step.number}
              </span>
              <div class="w-10 h-10 text-bower-primary group-hover:text-bower-primary/80 transition-colors duration-200 flex-shrink-0">
                <Fragment set:html={step.icon} />
              </div>
            </div>

            <!-- Content -->
            <h3 class="font-heading text-lg font-bold text-bower-primary-dark mb-2">{step.title}</h3>
            <p class="text-bower-primary/80 text-sm leading-relaxed">{step.desc}</p>

            <!-- Bottom accent line -->
            <div class="absolute bottom-0 left-6 right-6 h-px bg-gradient-to-r from-bower-primary/0 via-bower-primary/60 to-bower-primary/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
