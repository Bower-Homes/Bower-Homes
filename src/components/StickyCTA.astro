---
const waLink = `https://wa.me/12012109949?text=${encodeURIComponent('Hola Freddy, quiero saber más sobre las oportunidades de inversión de Bower Homes.')}`;
---

<!--
  StickyCTA — aparece tras 600px de scroll en desktop y mobile.
  En mobile se posiciona sobre el botón flotante de WhatsApp.
  Se oculta automáticamente cuando #contacto es visible.
-->
<div
  id="sticky-cta"
  class="fixed z-40 opacity-0 translate-y-3 pointer-events-none transition-all duration-300 ease-out"
  aria-hidden="true"
>
  <!-- Desktop: píldora centrada -->
  <div class="hidden md:flex items-center gap-3 bg-blue-900/95 backdrop-blur-md border border-blue-700/80 rounded-2xl px-5 py-3 shadow-2xl shadow-blue-950/60">
    <a
      href="#contacto"
      class="flex items-center gap-2 bg-sky-400 hover:bg-sky-500 active:bg-sky-600 text-blue-900 font-semibold text-sm px-5 py-2.5 rounded-xl transition-colors duration-150 shadow-sm shadow-sky-400/30"
      aria-label="Agendar llamada — ir a sección de contacto"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      Agendar llamada de 15 min
    </a>

    <div class="w-px h-7 bg-blue-700"></div>

    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-white/70 hover:text-white text-sm font-medium transition-colors duration-150 pr-1"
      aria-label="Contactar por WhatsApp"
    >
      <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp
    </a>
  </div>

  <!-- Mobile: franja full-width -->
  <div class="md:hidden flex items-stretch w-full border-t border-blue-700/60 bg-blue-900/98 backdrop-blur-sm">
    <a
      href="#contacto"
      class="flex flex-1 items-center justify-center gap-2 bg-sky-400 hover:bg-sky-500 text-blue-900 font-semibold py-4 text-sm transition-colors duration-150"
      aria-label="Agendar llamada — ir a sección de contacto"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      Agendar llamada de 15 min
    </a>
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center px-5 bg-blue-800 hover:bg-blue-700 border-l border-blue-700 transition-colors duration-150"
      aria-label="Contactar por WhatsApp"
    >
      <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </div>
</div>

<script>
  const el = document.getElementById('sticky-cta');
  const contactSection = document.getElementById('contacto');
  const floatingWa = document.getElementById('floating-wa');

  let contactVisible = false;

  // Ocultar/mostrar según visibilidad del #contacto
  const contactObserver = new IntersectionObserver(
    (entries) => {
      contactVisible = entries[0].isIntersecting;
      update();
    },
    { threshold: 0.15 }
  );
  if (contactSection) contactObserver.observe(contactSection);

  function update() {
    const shouldShow = window.scrollY > 600 && !contactVisible;

    if (shouldShow) {
      el?.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
      el?.classList.add('opacity-100', 'translate-y-0');
      el?.setAttribute('aria-hidden', 'false');
      // Subir el botón flotante de WhatsApp en mobile para no solaparlo
      if (window.innerWidth < 768 && floatingWa) {
        floatingWa.style.bottom = '4.5rem'; // 72px — por encima de la barra
      }
    } else {
      el?.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
      el?.classList.remove('opacity-100', 'translate-y-0');
      el?.setAttribute('aria-hidden', 'true');
      if (floatingWa) floatingWa.style.bottom = '';
    }
  }

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });

  // Posicionamiento inicial del sticky (desktop: centrado arriba del viewport bottom)
  function position() {
    if (!el) return;
    if (window.innerWidth >= 768) {
      // Desktop: centrado horizontalmente, bottom-6
      el.style.bottom = '1.5rem';
      el.style.left = '50%';
      el.style.transform = el.classList.contains('translate-y-3')
        ? 'translateX(-50%) translateY(0.75rem)'
        : 'translateX(-50%) translateY(0)';
      el.style.width = 'auto';
    } else {
      // Mobile: full-width, bottom-0
      el.style.bottom = '0';
      el.style.left = '0';
      el.style.transform = '';
      el.style.width = '100%';
    }
  }

  position();
  window.addEventListener('resize', position, { passive: true });
</script>
