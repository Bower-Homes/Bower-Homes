---
import { t } from '../i18n/landing';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const tx = t[lang].comparativa;
const rows = tx.rows;
---

<section class="py-20 bg-bower-gray-light/20 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="reveal inline-block text-bower-primary font-semibold text-sm tracking-widest uppercase mb-3">
        {tx.eyebrow}
      </div>
      <h2 class="reveal delay-100 section-title mb-4">
        {tx.h2}
      </h2>
      <p class="reveal delay-200 text-bower-primary/80 max-w-xl mx-auto leading-relaxed">
        {tx.sub}
      </p>
    </div>

    <!-- Table -->
    <div class="reveal delay-300 overflow-hidden rounded-2xl border border-bower-gray-light shadow-sm bg-white">
      <!-- Table header -->
      <div class="grid grid-cols-3 bg-bower-primary-dark text-white">
        <div class="px-6 py-5 text-sm font-semibold text-bower-accent-light/70 uppercase tracking-wider">
          {tx.featureLabel}
        </div>
        <div class="px-6 py-5 border-l border-bower-primary/50 text-center">
          <div class="font-heading text-lg font-bold text-white">{tx.col1}</div>
          <div class="text-bower-accent-light text-xs mt-0.5">{tx.col1sub}</div>
        </div>
        <div class="px-6 py-5 border-l border-bower-primary/50 text-center">
          <div class="font-heading text-lg font-bold text-white">{tx.col2}</div>
          <div class="text-emerald-400 text-xs mt-0.5">{tx.col2sub}</div>
        </div>
      </div>

      <!-- Table rows -->
      {rows.map((row, i) => (
        <div class={`grid grid-cols-3 border-t border-bower-gray-light/60 ${i % 2 === 0 ? 'bg-white' : 'bg-bower-gray-light/20'} ${row.highlight ? 'bg-bower-primary/10' : ''}`}>
          <div class="px-6 py-4 text-sm font-medium text-bower-primary-dark flex items-center">
            {row.feature}
          </div>
          <div class={`px-6 py-4 border-l border-bower-gray-light/60 text-center text-sm ${row.highlight ? 'text-bower-primary font-bold' : 'text-bower-primary/80'} flex items-center justify-center gap-2`}>
            {row.equal && (
              <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            )}
            {row.colectiva}
          </div>
          <div class={`px-6 py-4 border-l border-bower-gray-light/60 text-center text-sm ${row.highlight ? 'text-emerald-600 font-bold' : 'text-bower-primary/80'} flex items-center justify-center gap-2`}>
            {row.equal && (
              <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            )}
            {row.llave}
          </div>
        </div>
      ))}

      <!-- Footer row: CTAs -->
      <div class="grid grid-cols-3 bg-bower-primary-dark border-t border-bower-primary/50">
        <div class="px-6 py-6 flex items-center">
          <span class="text-bower-accent-light/60 text-xs font-medium uppercase tracking-wider">{tx.startToday}</span>
        </div>
        <div class="px-6 py-6 border-l border-bower-primary/50 flex justify-center">
          <a href="#contacto" class="bg-white text-bower-primary-dark font-semibold text-sm px-6 py-3 rounded-xl hover:bg-bower-gray-light/50 transition-colors duration-200 inline-flex items-center gap-2 shadow-lg">
            {tx.cta1}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="px-6 py-6 border-l border-bower-primary/50 flex justify-center">
          <a href="#contacto" class="bg-white text-bower-primary-dark font-semibold text-sm px-6 py-3 rounded-xl hover:bg-bower-gray-light/50 transition-colors duration-200 inline-flex items-center gap-2 shadow-lg">
            {tx.cta2}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <p class="text-center text-bower-primary/80 text-xs mt-4 md:hidden">{tx.mobileNote}</p>
  </div>
</section>
