---
---
<section id="modelo" class="py-24 bg-bower-gray-light/20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="reveal inline-block text-bower-primary font-semibold text-sm tracking-widest uppercase mb-3">
        Nuestro modelo
      </div>
      <h2 class="reveal delay-100 section-title mb-4">
        El Bower — Diseño que vale
      </h2>
      <p class="reveal delay-200 text-bower-primary/80 max-w-xl mx-auto leading-relaxed">
        Una sola casa bien construida supera a diez mediocres. Nuestro modelo combina
        diseño contemporáneo, funcionalidad y materiales premium para maximizar el valor
        en el mercado de Florida.
      </p>
    </div>

    <!-- Main showcase -->
    <div class="grid lg:grid-cols-5 gap-8 items-start">
      <!-- Image gallery — 3/5 columns -->
      <div class="lg:col-span-3 reveal reveal-fade">
        <div class="rounded-2xl overflow-hidden shadow-2xl mb-3">
          <img
            id="main-house-img"
            src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=900&q=80"
            alt="El Bower — Fachada principal"
            class="w-full h-[420px] object-cover transition-all duration-500"
            loading="lazy"
          />
        </div>
        <!-- Thumbnails -->
        <div class="grid grid-cols-4 gap-2">
          {[
            { src: 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=300&q=70', alt: 'Fachada' },
            { src: 'https://images.unsplash.com/photo-1484154218962-a197022b5858?w=300&q=70', alt: 'Cocina' },
            { src: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=300&q=70', alt: 'Sala' },
            { src: 'https://images.unsplash.com/photo-1560185127-6ed189bf02f4?w=300&q=70', alt: 'Exterior' },
          ].map(({ src, alt }) => (
            <button
              class="thumb-btn rounded-lg overflow-hidden ring-2 ring-transparent hover:ring-bower-primary transition-all duration-200 first:ring-bower-primary"
              data-src={src}
              data-alt={alt}
            >
              <img src={src} alt={alt} class="w-full h-20 object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      </div>

      <!-- Specs — 2/5 columns -->
      <div class="lg:col-span-2">
        <!-- Model badge -->
        <div class="reveal inline-flex items-center gap-2 bg-bower-primary-dark text-bower-accent-light text-xs font-bold px-4 py-2 rounded-full mb-5 tracking-wider">
          MODELO DESTACADO
        </div>

        <h3 class="reveal delay-100 font-heading text-3xl font-bold text-bower-primary-dark mb-2">El Bower</h3>
        <p class="reveal delay-200 text-bower-primary/80 mb-6 leading-relaxed">
          Single Family Home de 3 habitaciones con acabados de lujo, espacios abiertos
          y adaptada para el clima y mercado de Florida.
        </p>

        <!-- Key specs grid -->
        <div class="reveal delay-300 grid grid-cols-2 gap-3 mb-6">
          <!-- Habitaciones -->
          <div class="bg-white rounded-xl p-4 border border-bower-gray-light hover:border-bower-accent-light transition-colors duration-200">
            <svg class="w-6 h-6 text-bower-primary mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <!-- Cama doble: base + cabecero + almohadas -->
              <rect x="2" y="14" width="20" height="6" rx="1"/>
              <path d="M2 14v-3a1 1 0 011-1h18a1 1 0 011 1v3"/>
              <rect x="4" y="10" width="6" height="4" rx="0.5"/>
              <rect x="14" y="10" width="6" height="4" rx="0.5"/>
              <line x1="2" y1="20" x2="2" y2="22"/>
              <line x1="22" y1="20" x2="22" y2="22"/>
            </svg>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wide">Habitaciones</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">3</div>
          </div>
          <!-- Baños -->
          <div class="bg-white rounded-xl p-4 border border-bower-gray-light hover:border-bower-accent-light transition-colors duration-200">
            <svg class="w-6 h-6 text-bower-primary mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <!-- Bañera de planta: contorno + grifo + desagüe -->
              <path d="M4 17h16a1 1 0 001-1v-2H3v2a1 1 0 001 1z"/>
              <path d="M3 14V8a2 2 0 012-2h1v8"/>
              <line x1="7" y1="17" x2="7" y2="19"/>
              <line x1="17" y1="17" x2="17" y2="19"/>
              <circle cx="11" cy="11" r="1" fill="currentColor" stroke="none"/>
              <line x1="5" y1="6" x2="5" y2="4"/>
              <line x1="5" y1="4" x2="8" y2="4"/>
            </svg>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wide">Baños</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">3</div>
          </div>
          <!-- Área construida -->
          <div class="bg-white rounded-xl p-4 border border-bower-gray-light hover:border-bower-accent-light transition-colors duration-200">
            <svg class="w-6 h-6 text-bower-primary mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <!-- Plano de planta: rectángulo exterior + cotas -->
              <rect x="3" y="5" width="14" height="14" rx="0.5"/>
              <line x1="3" y1="2" x2="17" y2="2"/>
              <line x1="3" y1="2" x2="3" y2="4"/>
              <line x1="17" y1="2" x2="17" y2="4"/>
              <line x1="20" y1="5" x2="20" y2="19"/>
              <line x1="18" y1="5" x2="22" y2="5"/>
              <line x1="18" y1="19" x2="22" y2="19"/>
              <line x1="7" y1="12" x2="13" y2="12" stroke-dasharray="1.5 1"/>
              <line x1="10" y1="8" x2="10" y2="16" stroke-dasharray="1.5 1"/>
            </svg>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wide">Área construida</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">1,850 sqft</div>
          </div>
          <!-- Garaje -->
          <div class="bg-white rounded-xl p-4 border border-bower-gray-light hover:border-bower-accent-light transition-colors duration-200">
            <svg class="w-6 h-6 text-bower-primary mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <!-- Garaje: puerta seccionada + piso -->
              <rect x="2" y="8" width="20" height="13" rx="0.5"/>
              <path d="M2 8l4-5h12l4 5"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <line x1="2" y1="16" x2="22" y2="16"/>
              <line x1="9" y1="8" x2="9" y2="21"/>
              <line x1="15" y1="8" x2="15" y2="21"/>
            </svg>
            <div class="text-xs text-bower-primary/80 uppercase tracking-wide">Garaje</div>
            <div class="font-semibold text-bower-primary-dark mt-0.5">2 autos</div>
          </div>
        </div>

        <!-- Extras list -->
        <div class="reveal delay-400 bg-bower-primary-dark rounded-xl p-5 mb-6">
          <h4 class="text-bower-accent-light font-semibold text-sm uppercase tracking-wider mb-4">Extras y acabados</h4>
          <ul class="space-y-2">
            {[
              'Oficina / home office privado',
              'Lanai cubierto con vista al jardín',
              'Cocina abierta con isla central',
              'Acabados modernos de primera línea',
              'Sistema de eficiencia energética',
            ].map((item) => (
              <li class="flex items-center gap-2 text-bower-accent-light/80 text-sm">
                <svg class="w-4 h-4 text-bower-accent-light flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- CTA -->
        <div class="reveal delay-500 flex flex-col gap-3">
          <a href="#contacto" class="btn-primary justify-center">
            Solicitar información
          </a>
          <a
            href={`https://wa.me/12012109949?text=${encodeURIComponent('Hola, me interesa conocer más sobre El Bower de Bower Homes.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold py-3 px-6 rounded-lg hover:bg-[#22c55e] transition-colors duration-200"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const mainImg = document.getElementById('main-house-img') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!mainImg) return;

      // Update main image
      mainImg.src = btn.dataset.src ?? '';
      mainImg.alt = btn.dataset.alt ?? '';

      // Update active ring
      thumbBtns.forEach((b) => {
        b.classList.remove('ring-bower-primary');
        b.classList.add('ring-transparent');
      });
      btn.classList.add('ring-bower-primary');
      btn.classList.remove('ring-transparent');
    });
  });
</script>
