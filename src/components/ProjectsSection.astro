---
const projects = [
  {
    id: 1,
    name: 'Cape Coral — NW 14th Ave',
    type: 'Single Family Home',
    status: 'disponible',
    statusLabel: 'Disponible',
    price: '$389,000',
    beds: 3,
    baths: 2,
    sqft: '1,780',
    garage: '2 autos',
    purpose: 'invertir',
    description: 'Casa nueva de construcción reciente en vecindario tranquilo de Cape Coral. Acabados modernos, cocina abierta y lanai con vista al jardín.',
    image: 'https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=700&q=80',
    features: ['Pool ready', 'Lanai cubierto', 'Jardín privado'],
  },
  {
    id: 2,
    name: 'Lehigh Acres — Granada Blvd',
    type: 'Single Family Home',
    status: 'construccion',
    statusLabel: 'En construcción',
    price: '$342,000',
    beds: 3,
    baths: 2,
    sqft: '1,650',
    garage: '2 autos',
    purpose: 'invertir',
    description: 'Proyecto en etapa final de construcción en Lehigh Acres. Alta demanda de alquiler en la zona. Entrega estimada en 60 días.',
    image: 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=700&q=80',
    features: ['Entrega en 60 días', 'Alta demanda de alquiler', 'Zona en crecimiento'],
  },
  {
    id: 3,
    name: 'Fort Myers — McGregor Blvd',
    type: 'Single Family Home',
    status: 'disponible',
    statusLabel: 'Disponible',
    price: '$425,000',
    beds: 4,
    baths: 3,
    sqft: '2,100',
    garage: '2 autos',
    purpose: 'habitar',
    description: 'Ubicación premium sobre McGregor Blvd. Cuatro habitaciones, acabados de lujo y acceso rápido a las mejores zonas de Fort Myers.',
    image: 'https://images.unsplash.com/photo-1605276374104-dee2a0ed3cd6?w=700&q=80',
    features: ['Ubicación premium', 'Acabados de lujo', '4 habitaciones'],
  },
];

const statusStyles: Record<string, string> = {
  disponible: 'bg-emerald-100 text-emerald-700',
  construccion: 'bg-sky-100 text-sky-700',
  vendido: 'bg-gray-100 text-gray-500',
};
---

<section id="proyectos" class="py-24 bg-blue-900 text-white">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <div class="reveal inline-block text-sky-500 font-semibold text-sm tracking-widest uppercase mb-3">
          Proyectos actuales
        </div>
        <h2 class="reveal delay-100 section-title-light">
          Casas disponibles
        </h2>
        <p class="reveal delay-200 text-blue-300 mt-3 max-w-lg leading-relaxed">
          Propiedades desarrolladas por Bower Homes listas para su nuevo dueño.
          Todas con garantía de construcción y documentación en regla.
        </p>
      </div>
      <!-- Legend -->
      <div class="reveal delay-300 flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-2 text-sm text-blue-300">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          Disponible
        </div>
        <div class="flex items-center gap-2 text-sm text-blue-300">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
          En construcción
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="reveal delay-300 flex gap-0 mb-8">
      <div class="flex bg-blue-800/60 border border-blue-700 rounded-xl overflow-hidden">
        <button
          id="tab-invertir"
          class="project-tab px-6 py-3 text-sm font-semibold transition-all duration-200 bg-sky-400 text-blue-900"
          data-purpose="invertir"
        >
          Para invertir
        </button>
        <button
          id="tab-habitar"
          class="project-tab px-6 py-3 text-sm font-semibold transition-all duration-200 text-blue-300 hover:text-white hover:bg-blue-700/50"
          data-purpose="habitar"
        >
          Para habitar
        </button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((p, i) => (
        <article
          data-purpose={p.purpose}
          class={`project-card reveal delay-${i * 100} group bg-blue-800/50 rounded-2xl border border-blue-700 overflow-hidden hover:shadow-xl hover:border-sky-500/50 transition-all duration-300`}
        >
          <!-- Image -->
          <div class="relative overflow-hidden h-52">
            <img
              src={p.image}
              alt={p.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <!-- Status badge -->
            <div class={`absolute top-4 left-4 ${statusStyles[p.status]} text-xs font-semibold px-3 py-1.5 rounded-full backdrop-blur-sm`}>
              {p.statusLabel}
            </div>
            <!-- Price -->
            <div class="absolute bottom-4 right-4 bg-blue-900/90 backdrop-blur-sm text-white text-sm font-bold px-4 py-2 rounded-xl">
              {p.price}
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <div class="text-xs text-sky-400 font-semibold uppercase tracking-wider mb-1">{p.type}</div>
            <h3 class="font-heading text-lg font-bold text-white mb-2 leading-snug">{p.name}</h3>
            <p class="text-blue-300 text-sm leading-relaxed mb-4">{p.description}</p>

            <!-- Specs row -->
            <div class="flex items-center gap-4 py-3 border-y border-blue-700 mb-4 text-sm text-blue-200">
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span>{p.beds} hab</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{p.baths} baños</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
                <span>{p.sqft} sqft</span>
              </div>
            </div>

            <!-- Feature tags -->
            <div class="flex flex-wrap gap-2 mb-5">
              {p.features.map((f) => (
                <span class="bg-blue-900/60 text-blue-300 text-xs px-2.5 py-1 rounded-lg border border-blue-700">
                  {f}
                </span>
              ))}
            </div>

            <!-- CTA -->
            <a
              href={`https://wa.me/12012109949?text=${encodeURIComponent(`Hola, me interesa la propiedad en ${p.name} (${p.price}). ¿Pueden darme más información?`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full bg-blue-900 hover:bg-sky-500 text-white text-sm font-semibold py-3 rounded-xl border border-blue-700 transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              Consultar propiedad
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty state -->
    <div id="projects-empty" class="hidden py-16 text-center text-blue-300">
      <svg class="w-12 h-12 mx-auto mb-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <p class="text-sm">No hay propiedades disponibles en esta categoría por el momento.</p>
      <p class="text-xs mt-1 text-blue-400">Contactanos — siempre tenemos proyectos nuevos en camino.</p>
    </div>

    <!-- Bottom CTA -->
    <div class="reveal mt-12 text-center">
      <p class="text-blue-300 text-sm mb-4">¿No encontraste lo que buscás? Contactanos — siempre tenemos proyectos nuevos.</p>
      <a href="#contacto" class="btn-primary">
        Ver todas las oportunidades
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.project-tab');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const emptyState = document.getElementById('projects-empty');

  function filterProjects(purpose: string) {
    let visible = 0;

    cards.forEach((card) => {
      const match = card.dataset.purpose === purpose;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }

    tabs.forEach((tab) => {
      const active = tab.dataset.purpose === purpose;
      tab.classList.toggle('bg-sky-400', active);
      tab.classList.toggle('text-blue-900', active);
      tab.classList.toggle('text-blue-300', !active);
      tab.classList.remove('hover:text-white', 'hover:bg-blue-700/50');
      if (!active) {
        tab.classList.add('hover:text-white', 'hover:bg-blue-700/50');
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterProjects(tab.dataset.purpose ?? 'invertir');
    });
  });

  // Initialize: show "invertir" tab
  filterProjects('invertir');
</script>
