---
import { t } from '../i18n/landing';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const tx = t[lang].products;
const products = tx.items;
---

<section id="productos" class="py-24 bg-bower-primary-dark text-white overflow-hidden relative">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-0 w-96 h-96 bg-bower-primary/5 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-bower-primary/30 rounded-full translate-x-1/2 translate-y-1/2"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center mb-14">
      <div class="reveal inline-block text-bower-accent-light font-semibold text-sm tracking-widest uppercase mb-3">
        {tx.eyebrow}
      </div>
      <h2 class="reveal delay-100 section-title-light mb-4">
        {tx.h2}
      </h2>
      <p class="reveal delay-200 text-bower-accent-light/80 max-w-xl mx-auto leading-relaxed">
        {tx.sub}
      </p>
    </div>

    <!-- Tabs -->
    <div class="reveal delay-300">
      <div class="flex justify-center gap-0 mb-0 relative">
        <div class="flex bg-bower-primary/60 border border-bower-primary/50 rounded-t-xl overflow-hidden">
          {products.map((p, i) => (
            <button
              data-tab={p.id}
              class={`tab-btn px-8 py-4 text-sm font-semibold transition-all duration-200 relative ${
                i === 0
                  ? 'bg-bower-primary text-white'
                  : 'text-white/70 hover:text-white hover:bg-bower-primary/50'
              }`}
            >
              <span class="relative z-10">{p.label}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="bg-bower-primary/20 border border-bower-primary/40 rounded-b-2xl rounded-tr-2xl overflow-hidden">
        {products.map((p, i) => (
          <div
            id={`tab-${p.id}`}
            class={`tab-panel p-8 md:p-12 ${i !== 0 ? 'hidden' : ''}`}
          >
            <div class="grid md:grid-cols-2 gap-12 items-start">
              <div>
                <div class={`inline-flex items-center gap-2 ${p.badgeColor} text-xs font-semibold px-3 py-1.5 rounded-full mb-4`}>
                  {p.badge}
                </div>
                <h3 class="font-heading text-3xl font-bold text-white mb-3">{p.label}</h3>
                <p class="text-bower-accent-light font-medium mb-4">{p.tagline}</p>
                <p class="text-bower-accent-light/80 leading-relaxed mb-6">{p.description}</p>

                <div class="flex gap-8 p-5 bg-bower-primary-dark/50 rounded-xl border border-bower-primary/40 mb-6">
                  <div>
                    <div class="font-heading text-3xl font-bold text-bower-accent-light">{p.roi}</div>
                    <div class="text-bower-accent-light/70 text-xs mt-1">{p.roiLabel}</div>
                  </div>
                  <div class="w-px bg-bower-primary/50"></div>
                  <div>
                    <div class="font-heading text-3xl font-bold text-white">{p.term}</div>
                    <div class="text-bower-accent-light/70 text-xs mt-1">{p.termLabel}</div>
                  </div>
                </div>

                <p class="text-bower-accent-light/70 text-sm italic border-l-2 border-bower-accent-light/50 pl-4">
                  {p.profile}
                </p>
              </div>

              <div>
                <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">{tx.whatsIncluded}</h4>
                <ul class="space-y-3 mb-8">
                  {p.benefits.map((b) => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-bower-accent-light mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-bower-accent-light/90 text-sm leading-relaxed">{b}</span>
                    </li>
                  ))}
                </ul>
                <a href="#contacto" class="btn-primary w-full justify-center text-base">
                  {p.cta}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabBtns.forEach((b) => {
        b.classList.remove('bg-bower-primary', 'text-white');
        b.classList.add('text-white/70');
      });
      btn.classList.add('bg-bower-primary', 'text-white');
      btn.classList.remove('text-white/70');
      tabPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== `tab-${target}`);
      });
    });
  });
</script>
