---
export interface Props {
  variant?: 'navbar';
  class?: string;
}

const { variant = 'navbar', class: className = '' } = Astro.props;
---

{variant === 'navbar' && (
  <a
    href="#nosotros"
    aria-label="Bower Homes - Nosotros"
    class:list={['flex items-center gap-3', className]}
  >
    {/* Icon: LOGO-03 inverted to white for dark navbar */}
    <img
      src="/brand/logos/BOWER_LOGO-03.png"
      alt="Bower Homes logo"
      class="h-11 w-auto flex-shrink-0"
      style="filter: brightness(0) invert(1);"
    />
    {/* Wordmark: visible on all sizes. Slogan: hidden on mobile, shown sm+ */}
    <span class="flex flex-col gap-0.5">
      <span class="flex items-baseline gap-1.5 text-xl uppercase tracking-tight leading-none">
        <span class="font-sans font-extrabold text-white">Bower</span>
        <span class="font-sans font-light" style="color:#D9B48F;">Homes</span>
      </span>
      <span class="hidden sm:block text-[0.48rem] font-light tracking-[0.12em] text-white/45 leading-none">
        Built With Purpose. Designed With Care.
      </span>
    </span>
  </a>
)}
