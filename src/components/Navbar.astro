---
import BrandLogo from './BrandLogo.astro';
---
<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 py-4 text-white"
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <!-- Logo -->
    <BrandLogo variant="navbar" />

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {[
        { label: 'Inicio', href: '#inicio' },
        { label: 'Nosotros', href: '#nosotros' },
        { label: 'Modelo', href: '#modelo' },
        { label: 'Proyectos', href: '#proyectos' },
        { label: 'Invierte', href: '#productos' },
        { label: 'Contacto', href: '#contacto' },
      ].map(({ label, href }) => (
        <a
          href={href}
          class="nav-link text-sm font-medium text-white/90 hover:text-bower-accent-light transition-colors duration-200 relative after:absolute after:bottom-[-2px] after:left-0 after:h-[2px] after:w-0 after:bg-bower-accent-light after:transition-all after:duration-200 hover:after:w-full"
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="/portal"
        class="bg-bower-primary text-white font-semibold text-sm px-5 py-2.5 rounded-lg hover:bg-bower-primary/85 transition-all duration-200"
      >
        Acceder al Portal
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Abrir menú"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-4 h-0.5 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-bower-primary-dark/95 backdrop-blur-sm border-t border-bower-primary/30 mt-4"
  >
    <nav class="flex flex-col px-6 py-4 gap-1">
      {[
        { label: 'Inicio', href: '#inicio' },
        { label: 'Nosotros', href: '#nosotros' },
        { label: 'Modelo', href: '#modelo' },
        { label: 'Proyectos', href: '#proyectos' },
        { label: 'Invierte', href: '#productos' },
        { label: 'Contacto', href: '#contacto' },
      ].map(({ label, href }) => (
        <a
          href={href}
          class="mobile-nav-link text-white/90 hover:text-bower-accent-light py-3 border-b border-bower-primary/30 text-sm font-medium transition-colors duration-200"
        >
          {label}
        </a>
      ))}
      <a
        href="/portal"
        class="mt-3 bg-bower-primary text-white font-semibold text-sm px-5 py-3 rounded-lg text-center"
      >
        Acceder al Portal
      </a>
    </nav>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerLines = document.querySelectorAll('.hamburger-line');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  // Scroll handler — transparent over hero, solid on scroll
  window.addEventListener('scroll', () => {
    if (!navbar) return;
    if (window.scrollY > 60) {
      navbar.classList.add('bg-bower-primary-dark', 'shadow-lg');
      navbar.classList.remove('py-4');
      navbar.classList.add('py-3');
    } else {
      navbar.classList.remove('bg-bower-primary-dark', 'shadow-lg');
      navbar.classList.remove('py-3');
      navbar.classList.add('py-4');
    }
  });

  // Mobile menu toggle
  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      hamburgerLines[2]?.classList.remove('w-6');
      hamburgerLines[2]?.classList.add('w-4');
    } else {
      mobileMenu?.classList.remove('hidden');
      hamburgerLines[2]?.classList.add('w-6');
      hamburgerLines[2]?.classList.remove('w-4');
    }
  });

  // Close mobile menu when a link is clicked
  mobileNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerLines[2]?.classList.remove('w-6');
      hamburgerLines[2]?.classList.add('w-4');
    });
  });
</script>
