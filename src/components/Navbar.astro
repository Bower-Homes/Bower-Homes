---
import BrandLogo from './BrandLogo.astro';
import { t } from '../i18n/landing';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const tx = t[lang].navbar;
const otherLang = lang === 'en' ? 'es' : 'en';
const otherUrl  = lang === 'en' ? '/es' : '/';
const otherFlag = lang === 'en' ? '🇪🇸' : '🇺🇸';
const thisFlag  = lang === 'en' ? '🇺🇸' : '🇪🇸';
---
<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 py-4 text-white bg-bower-primary-dark shadow-sm"
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <!-- Logo -->
    <BrandLogo variant="navbar" />

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {tx.links.map(({ label, href }) => (
        <a
          href={href}
          class="nav-link text-sm font-medium text-white/90 hover:text-bower-accent-light transition-colors duration-200 relative after:absolute after:bottom-[-2px] after:left-0 after:h-[2px] after:w-0 after:bg-bower-accent-light after:transition-all after:duration-200 hover:after:w-full"
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Right side: Lang switcher + Portal CTA -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Language switcher -->
      <div class="flex items-center gap-1 bg-bower-primary/30 border border-bower-primary/50 rounded-lg px-1 py-1">
        <!-- Current lang (active) -->
        <span
          class="inline-flex items-center px-2 py-1.5 rounded-md bg-bower-primary cursor-default select-none"
          aria-current="true"
          title={lang === 'en' ? 'English' : 'Español'}
        >
          <span class="text-xl leading-none">{thisFlag}</span>
        </span>
        <!-- Other lang -->
        <a
          href={otherUrl}
          class="inline-flex items-center px-2 py-1.5 rounded-md opacity-50 hover:opacity-100 hover:bg-bower-primary/50 transition-all duration-150"
          aria-label={`Switch to ${otherLang === 'en' ? 'English' : 'Español'}`}
          title={otherLang === 'en' ? 'English' : 'Español'}
        >
          <span class="text-xl leading-none">{otherFlag}</span>
        </a>
      </div>

      <!-- Portal CTA -->
      <a
        href="/portal"
        class="font-semibold text-sm px-5 py-2.5 rounded-lg transition-all duration-200"
        style="background:#D9B48F;color:#041E42;"
        onmouseover="this.style.background='#c9a07f'"
        onmouseout="this.style.background='#D9B48F'"
      >
        {tx.portal}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label={tx.mobileMenuLabel}
    >
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-4 h-0.5 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-bower-primary-dark/95 backdrop-blur-sm border-t border-bower-primary/30 mt-4"
  >
    <nav class="flex flex-col px-6 py-4 gap-1">
      {tx.links.map(({ label, href }) => (
        <a
          href={href}
          class="mobile-nav-link text-white/90 hover:text-bower-accent-light py-3 border-b border-bower-primary/30 text-sm font-medium transition-colors duration-200"
        >
          {label}
        </a>
      ))}

      <!-- Language switcher (mobile) -->
      <div class="flex items-center gap-2 py-3 border-b border-bower-primary/30">
        <span class="inline-flex items-center px-2 py-1 rounded-lg bg-bower-primary" title={lang === 'en' ? 'English' : 'Español'}>
          <span class="text-xl leading-none">{thisFlag}</span>
        </span>
        <a
          href={otherUrl}
          class="inline-flex items-center px-2 py-1 rounded-lg border border-bower-primary/50 opacity-50 hover:opacity-100 transition-opacity duration-150"
          title={otherLang === 'en' ? 'English' : 'Español'}
        >
          <span class="text-xl leading-none">{otherFlag}</span>
        </a>
      </div>

      <a
        href="/portal"
        class="mt-3 font-semibold text-sm px-5 py-3 rounded-lg text-center"
        style="background:#D9B48F;color:#041E42;"
      >
        {tx.portal}
      </a>
    </nav>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerLines = document.querySelectorAll('.hamburger-line');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  window.addEventListener('scroll', () => {
    if (!navbar) return;
    if (window.scrollY > 60) {
      navbar.classList.add('shadow-lg');
      navbar.classList.remove('shadow-sm', 'py-4');
      navbar.classList.add('py-3');
    } else {
      navbar.classList.remove('shadow-lg', 'py-3');
      navbar.classList.add('shadow-sm', 'py-4');
    }
  });

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      hamburgerLines[2]?.classList.remove('w-6');
      hamburgerLines[2]?.classList.add('w-4');
    } else {
      mobileMenu?.classList.remove('hidden');
      hamburgerLines[2]?.classList.add('w-6');
      hamburgerLines[2]?.classList.remove('w-4');
    }
  });

  mobileNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerLines[2]?.classList.remove('w-6');
      hamburgerLines[2]?.classList.add('w-4');
    });
  });
</script>
