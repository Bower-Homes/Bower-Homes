---
import { getPortalT, type PortalLang } from '../../i18n/portal';

interface Props {
  title: string;
  user: { fullName: string; email: string; role: string };
  activeNav?: string;
  lang?: PortalLang;
}
const { title, user, activeNav = 'dashboard', lang = 'es' } = Astro.props;
const t = getPortalT(lang);

const navItems = [
  { id: 'dashboard', label: t.layout.dashboard, href: '/portal/admin/', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />` },
  { id: 'proyectos', label: t.layout.projects, href: '/portal/admin/proyectos', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />` },
  { id: 'usuarios', label: t.layout.clients, href: '/portal/admin/usuarios', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />` },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{title} — BOWER Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy-900: #0c1524;
      --navy-800: #141d34;
      --navy-700: #1e2a45;
      --navy-600: #2c3a5c;
      --navy-500: #3d4f72;
      --navy-400: #5e6d8c;
      --navy-300: #8894b0;
      --navy-200: #b8c0d4;
      --navy-100: #dce0ea;
      --sky: #38bdf8;
      --sky-hover: #0ea5e9;
      --sky-active: #0284c7;
      --sky-light: rgba(56,189,248,0.08);
      --sky-light2: rgba(56,189,248,0.15);
      --surface: #f4f5f9;
      --surface-alt: #eceef4;
      --white: #ffffff;
      --border: #e2e5ee;
      --border-light: #eef0f5;
      --success: #22c55e;
      --success-bg: #dcfce7;
      --error: #ef4444;
      --error-bg: #fef2f2;
      --warning-bg: #fef9c3;
      --info-bg: #dbeafe;
      --sidebar-w: 260px;
      --topbar-h: 64px;
      --radius: 0.75rem;
      --radius-lg: 1rem;
      --shadow-sm: 0 1px 3px rgba(12,21,36,0.04), 0 1px 2px rgba(12,21,36,0.06);
      --shadow-md: 0 4px 12px rgba(12,21,36,0.06), 0 2px 4px rgba(12,21,36,0.04);
      --shadow-lg: 0 12px 40px rgba(12,21,36,0.1), 0 4px 12px rgba(12,21,36,0.05);
      --shadow-xl: 0 20px 60px rgba(12,21,36,0.15);
      --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    html, body { overflow-x: hidden; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--surface);
      color: var(--navy-900);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Toast ── */
    .toast {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      padding: 0.85rem 1.25rem; border-radius: var(--radius);
      font-size: 0.85rem; font-weight: 600;
      box-shadow: var(--shadow-lg);
      z-index: 9999; transform: translateY(120px);
      opacity: 0; transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none; display: flex; align-items: center; gap: 0.5rem;
    }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { background: var(--success-bg); color: #15803d; border: 1px solid #bbf7d0; }
    .toast.error { background: var(--error-bg); color: #dc2626; border: 1px solid #fecaca; }

    /* ── Sidebar ── */
    .sidebar {
      position: fixed; left: 0; top: 0; bottom: 0;
      width: var(--sidebar-w); background: var(--navy-900);
      display: flex; flex-direction: column; z-index: 40;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sidebar-logo {
      padding: 1.5rem 1.75rem; height: var(--topbar-h);
      display: flex; align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .sidebar-nav { flex: 1; padding: 1.25rem 1rem; }
    .sidebar-section-label {
      font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.12em; color: var(--navy-500); padding: 0.5rem 0.75rem;
      margin-bottom: 0.25rem;
    }
    .sidebar-link {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.65rem 0.85rem; border-radius: 0.6rem;
      color: var(--navy-300); text-decoration: none;
      font-size: 0.85rem; font-weight: 500;
      transition: all var(--transition); margin-bottom: 0.15rem;
      position: relative;
    }
    .sidebar-link:hover { background: rgba(255,255,255,0.05); color: var(--navy-100); }
    .sidebar-link.active {
      background: var(--sky-light2); color: var(--sky);
    }
    .sidebar-link.active::before {
      content: ''; position: absolute; left: -1rem; top: 50%; transform: translateY(-50%);
      width: 3px; height: 24px; background: var(--sky); border-radius: 0 3px 3px 0;
    }
    .sidebar-link svg { width: 20px; height: 20px; flex-shrink: 0; opacity: 0.7; }
    .sidebar-link.active svg { opacity: 1; }
    .sidebar-footer {
      padding: 1.25rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.06);
    }
    .sidebar-user {
      display: flex; align-items: center; gap: 0.75rem;
    }
    .sidebar-avatar {
      width: 36px; height: 36px; border-radius: 0.5rem;
      background: linear-gradient(135deg, var(--sky), var(--sky-active));
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.8rem; color: var(--navy-900);
      flex-shrink: 0;
    }
    .sidebar-user-info { flex: 1; min-width: 0; }
    .sidebar-user-name {
      color: var(--white); font-size: 0.8rem; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sidebar-user-email {
      color: var(--navy-400); font-size: 0.65rem; margin-top: 0.1rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sidebar-logout {
      margin-top: 1rem; width: 100%;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      color: var(--navy-300); font-size: 0.75rem; font-weight: 600;
      padding: 0.55rem; border-radius: 0.5rem;
      cursor: pointer; transition: all var(--transition);
      font-family: 'DM Sans', sans-serif;
    }
    .sidebar-logout:hover { border-color: rgba(239,68,68,0.4); color: #f87171; background: rgba(239,68,68,0.08); }

    /* Mobile */
    .mobile-toggle {
      display: none; position: fixed; top: 0.85rem; left: 0.85rem;
      z-index: 50; background: var(--navy-900); border: 1px solid var(--navy-700);
      color: var(--white); width: 42px; height: 42px; border-radius: 0.6rem;
      cursor: pointer; align-items: center; justify-content: center;
      box-shadow: var(--shadow-md);
    }
    .mobile-toggle svg { width: 20px; height: 20px; }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6);
      z-index: 35; backdrop-filter: blur(4px);
    }

    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .sidebar-overlay.open { display: block; }
      .mobile-toggle { display: flex; }
      .main-content { margin-left: 0 !important; }
      .topbar { padding-left: 3.75rem !important; }
    }

    /* ── Main ── */
    .main-content { margin-left: var(--sidebar-w); min-height: 100vh; }

    .topbar {
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 0 2rem; height: var(--topbar-h);
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 30;
      box-shadow: 0 1px 0 rgba(0,0,0,0.03);
    }
    .topbar-title {
      font-weight: 700; font-size: 1.15rem; color: var(--navy-900);
      font-family: 'Playfair Display', serif;
    }
    .topbar-right { display: flex; align-items: center; gap: 0.75rem; }

    .content-area { padding: 2rem; max-width: 1280px; }
    @media (max-width: 768px) { .content-area { padding: 1.25rem; } }

    /* ── Cards ── */
    .card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: var(--radius-lg); overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition);
    }
    .card:hover { box-shadow: var(--shadow-md); }
    .card-header {
      padding: 1.15rem 1.5rem; font-weight: 700; font-size: 0.9rem;
      color: var(--navy-900); border-bottom: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: space-between;
      background: linear-gradient(to bottom, var(--white), #fcfcfd);
    }

    /* ── Buttons ── */
    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.6rem 1.1rem; border-radius: 0.6rem;
      font-size: 0.8rem; font-weight: 600;
      cursor: pointer; transition: all var(--transition); border: none;
      text-decoration: none; white-space: nowrap;
      font-family: 'DM Sans', sans-serif;
    }
    .btn svg { width: 16px; height: 16px; }
    .btn-primary {
      background: var(--sky); color: var(--navy-900);
      box-shadow: 0 1px 3px rgba(56,189,248,0.3);
    }
    .btn-primary:hover { background: var(--sky-hover); color: #fff; box-shadow: 0 4px 12px rgba(56,189,248,0.35); transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }
    .btn-secondary { background: var(--white); color: var(--navy-900); border: 1px solid var(--border); }
    .btn-secondary:hover { background: var(--surface); border-color: var(--navy-200); }
    .btn-danger { background: var(--error-bg); color: #dc2626; border: 1px solid #fecaca; }
    .btn-danger:hover { background: #fee2e2; border-color: #f87171; }
    .btn-sm { padding: 0.4rem 0.75rem; font-size: 0.75rem; border-radius: 0.5rem; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }

    /* ── Tables ── */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    thead th {
      text-align: left; padding: 0.85rem 1.25rem;
      font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: var(--navy-400);
      border-bottom: 1px solid var(--border); white-space: nowrap;
      background: #fafbfd;
    }
    tbody td {
      padding: 0.95rem 1.25rem; font-size: 0.85rem;
      border-bottom: 1px solid var(--border-light); color: var(--navy-900);
    }
    tbody tr { transition: background var(--transition); }
    tbody tr:hover { background: #f8f9fc; }
    tbody tr:last-child td { border-bottom: none; }

    /* ── Badges ── */
    .badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-size: 0.65rem; font-weight: 700;
      padding: 0.25rem 0.65rem; border-radius: 999px;
      text-transform: uppercase; letter-spacing: 0.03em;
    }
    .badge::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
    }
    .badge-active { background: var(--success-bg); color: #15803d; }
    .badge-active::before { background: #22c55e; }
    .badge-paused { background: var(--warning-bg); color: #a16207; }
    .badge-paused::before { background: #f59e0b; }
    .badge-completed { background: var(--info-bg); color: #1d4ed8; }
    .badge-completed::before { background: #3b82f6; }
    .badge-inactive { background: #f3f4f6; color: #6b7280; }
    .badge-inactive::before { background: #9ca3af; }
    .badge-progress { background: var(--warning-bg); color: #a16207; }
    .badge-progress::before { background: #f59e0b; }

    /* ── Modal ── */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(12,21,36,0.6);
      z-index: 100; display: none; align-items: center; justify-content: center;
      padding: 1rem; backdrop-filter: blur(4px);
      animation: fadeIn 0.2s ease;
    }
    .modal-overlay.open { display: flex; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .modal {
      background: var(--white); border-radius: var(--radius-lg); width: 100%;
      max-width: 520px; max-height: 90vh; overflow-y: auto;
      box-shadow: var(--shadow-xl);
      animation: slideUp 0.25s ease;
    }
    .modal-header {
      padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-title { font-weight: 700; font-size: 1.05rem; color: var(--navy-900); }
    .modal-close {
      width: 32px; height: 32px; border-radius: 0.5rem;
      border: none; background: var(--surface); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      color: var(--navy-400); transition: all var(--transition);
      font-size: 1.1rem;
    }
    .modal-close:hover { background: var(--error-bg); color: var(--error); }
    .modal-body { padding: 1.5rem; }
    .modal-footer {
      padding: 1rem 1.5rem; border-top: 1px solid var(--border-light);
      display: flex; justify-content: flex-end; gap: 0.5rem;
      background: #fafbfd;
    }

    /* ── Forms ── */
    .form-group { margin-bottom: 1.1rem; }
    .form-label {
      display: block; font-size: 0.72rem; font-weight: 700;
      color: var(--navy-400); text-transform: uppercase;
      letter-spacing: 0.06em; margin-bottom: 0.45rem;
    }
    .form-input, .form-select, .form-textarea {
      width: 100%; padding: 0.65rem 0.9rem; border: 1.5px solid var(--border);
      border-radius: 0.6rem; font-size: 0.85rem;
      font-family: 'DM Sans', sans-serif; color: var(--navy-900);
      background: var(--white); transition: all var(--transition); outline: none;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      border-color: var(--sky); box-shadow: 0 0 0 3px rgba(56,189,248,0.12);
    }
    .form-input::placeholder { color: var(--navy-200); }
    .form-textarea { resize: vertical; min-height: 80px; }

    /* ── Stats ── */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
    .stat-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 1.5rem;
      box-shadow: var(--shadow-sm); transition: all var(--transition);
      position: relative; overflow: hidden;
    }
    .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .stat-icon {
      width: 42px; height: 42px; border-radius: 0.6rem;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1rem;
    }
    .stat-icon svg { width: 22px; height: 22px; }
    .stat-icon.gold { background: var(--sky-light2); color: var(--sky-hover); }
    .stat-icon.blue { background: rgba(59,130,246,0.1); color: #3b82f6; }
    .stat-icon.green { background: rgba(34,197,94,0.1); color: #22c55e; }
    .stat-label {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: var(--navy-300); margin-bottom: 0.4rem;
    }
    .stat-value { font-size: 2rem; font-weight: 800; color: var(--navy-900); line-height: 1; }
    .stat-value.gold { color: var(--sky-hover); }

    /* ── Spinner ── */
    .spinner {
      width: 18px; height: 18px; border: 2.5px solid var(--border);
      border-top-color: var(--sky); border-radius: 50%;
      animation: spin 0.6s linear infinite; display: inline-block;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Empty state ── */
    .empty-state {
      text-align: center; padding: 3rem 1.5rem; color: var(--navy-300);
    }
    .empty-state-icon {
      width: 64px; height: 64px; margin: 0 auto 1.25rem;
      background: var(--surface); border-radius: 1rem;
      display: flex; align-items: center; justify-content: center;
    }
    .empty-state-icon svg { width: 28px; height: 28px; opacity: 0.5; }
    .empty-state p { font-size: 0.9rem; margin-bottom: 0.5rem; }
    .empty-state small { font-size: 0.8rem; color: var(--navy-200); }

    /* ── Tabs ── */
    .tabs {
      display: flex; gap: 0; border-bottom: 2px solid var(--border-light);
      overflow-x: auto; -webkit-overflow-scrolling: touch;
      padding: 0 0.5rem;
    }
    .tab {
      padding: 0.85rem 1.25rem; font-size: 0.8rem; font-weight: 600;
      color: var(--navy-300); cursor: pointer; border-bottom: 2px solid transparent;
      white-space: nowrap; transition: all var(--transition); background: none;
      border-top: none; border-left: none; border-right: none;
      margin-bottom: -2px;
      font-family: 'DM Sans', sans-serif;
    }
    .tab:hover { color: var(--navy-900); }
    .tab.active { color: var(--sky-hover); border-bottom-color: var(--sky); }
    .tab-content { display: none; padding: 1.75rem; }
    .tab-content.active { display: block; }

    /* ── Progress bar ── */
    .progress-bar {
      height: 6px; background: var(--surface-alt); border-radius: 3px;
      overflow: hidden; flex: 1; max-width: 100px;
    }
    .progress-fill {
      height: 100%; border-radius: 3px; transition: width 0.4s ease;
    }
    .progress-fill.gold { background: linear-gradient(90deg, var(--sky), var(--sky-hover)); }
    .progress-fill.green { background: linear-gradient(90deg, #22c55e, #16a34a); }

    /* ── Quick action cards ── */
    .quick-action {
      display: flex; align-items: center; gap: 1rem;
      padding: 1.5rem; text-decoration: none; color: inherit;
      transition: all var(--transition); border-radius: var(--radius-lg);
      background: var(--white); border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }
    .quick-action:hover {
      border-color: var(--sky); box-shadow: 0 4px 16px rgba(56,189,248,0.15);
      transform: translateY(-2px);
    }
    .quick-action-icon {
      width: 48px; height: 48px; border-radius: 0.75rem;
      background: var(--sky-light2);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: all var(--transition);
    }
    .quick-action:hover .quick-action-icon { background: var(--sky); }
    .quick-action-icon svg { width: 22px; height: 22px; color: var(--sky-hover); transition: color var(--transition); }
    .quick-action:hover .quick-action-icon svg { color: var(--navy-900); }
    .quick-action-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 0.15rem; }
    .quick-action-desc { font-size: 0.75rem; color: var(--navy-300); }
  </style>
</head>
<body>
  <!-- Mobile toggle -->
  <button class="mobile-toggle" id="mobile-toggle">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <a href="/portal/admin/" style="text-decoration:none;">
        <span style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#fff;letter-spacing:0.04em;">BOWER HOMES</span>
      </a>
    </div>
    <nav class="sidebar-nav">
      <div class="sidebar-section-label">{t.layout.menu}</div>
      {navItems.map(item => (
        <a href={item.href} class={`sidebar-link ${activeNav === item.id ? 'active' : ''}`}>
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><Fragment set:html={item.icon} /></svg>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="sidebar-avatar">{(user.fullName || user.email).charAt(0).toUpperCase()}</div>
        <div class="sidebar-user-info">
          <div class="sidebar-user-name">{user.fullName || 'Admin'}</div>
          <div class="sidebar-user-email">{user.email}</div>
        </div>
      </div>
      <button class="sidebar-logout" id="logout-btn">
        {t.layout.logout}
      </button>
    </div>
  </aside>

  <!-- Main -->
  <div class="main-content">
    <header class="topbar">
      <h1 class="topbar-title">{title}</h1>
      <div class="topbar-right">
        <slot name="topbar-actions" />
      </div>
    </header>
    <main class="content-area">
      <slot />
    </main>
  </div>

  <!-- Toast container -->
  <div class="toast" id="toast"></div>

  <script is:inline>
    // Sidebar mobile
    document.getElementById('mobile-toggle')?.addEventListener('click', function() {
      document.getElementById('sidebar')?.classList.toggle('open');
      document.getElementById('sidebar-overlay')?.classList.toggle('open');
    });
    document.getElementById('sidebar-overlay')?.addEventListener('click', function() {
      document.getElementById('sidebar')?.classList.remove('open');
      this.classList.remove('open');
    });

    // Logout
    document.getElementById('logout-btn')?.addEventListener('click', async function() {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/portal/login';
    });

    // Toast helper
    window.showToast = function(msg, type) {
      var t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg;
      t.className = 'toast ' + (type || 'success');
      setTimeout(function() { t.classList.add('show'); }, 10);
      setTimeout(function() { t.classList.remove('show'); }, 3500);
    };
  </script>
</body>
</html>
